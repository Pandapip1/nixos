From 1d378e3bed3e7776b8e8b3df2afe2c0b0b1e6001 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Subject: [PATCH] hwmon: macsmc: expose T600x PMU temperature keys

Exposes per-core PMU die temperature as a standard hwmon "Core N" channel
(plus each core's 3 individual raw probes as "Core N (Sensor M)"), for
btop/lm-sensors compatibility on T600x (M1 Pro/Max/Ultra) systems.

The original cut of this driver guessed its SMC key names (TP0b..TPab,
TP1l/TP2l/TP1g/TP2g/TP3g) from macOS's IOHID AppleARMPMUTempSensor
LocationIDs, since raw SMC keys were inaccessible to userspace on macOS
too -- it was never actually validated against a real key table on
either OS. Validated now by direct SMC query on real hardware (a small
out-of-tree debugfs dump of every key/type/value via macsmc's own
exported API): none of those key names exist on a real T6000. What
exists instead is a 30-key "Tp0*" family (lowercase 'p') that decomposes
into 10 groups of 3 lexicographically-consecutive suffix characters --
see the comment in macsmc-pmu-temp.c for the full key list and evidence
(all 30 keys rise together under all-core load while chassis/peripheral
sensors don't, confirming they're CPU/SoC-die-adjacent).

Also fixed: SMC_KEY(flt) (used by pmu_temp_is_float()) can never match a
real "flt " type code, since stringifying the 3-character token "flt"
yields a NUL 4th byte, not the space the real SMC type code has as its
4th byte (confirmed 0x666c7420 by direct register dump) -- this repo's
drivers/hwmon/macsmc-hwmon.c already works around the same macro
limitation via the explicit 4-arg __SMC_KEY() form, which this driver
now uses too.

Each core's temperature is now the average of its 3 raw probes rather
than picking one arbitrarily (as the original present_tdie[i*ntdie/ncores]
decimation would have done) -- userspace tools that build a per-core
view (e.g. btop, which this driver targets) expect exactly one value per
"Core N" label. The 3 raw probes remain available individually as
"Core N (Sensor M)" channels.

NOT yet confirmed: the exact group-to-logical-CPU assignment (currently
an ordinal assumption -- see the in-file comment for what would be
needed to confirm it).

Signed-off-by: Gavin John <gavinnjohn@gmail.com>
---
diff --git a/arch/arm64/boot/dts/apple/t600x-die0.dtsi b/arch/arm64/boot/dts/apple/t600x-die0.dtsi
--- a/arch/arm64/boot/dts/apple/t600x-die0.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-die0.dtsi
@@ -262,6 +262,10 @@
 			nvmem-cells = <&rtc_offset>;
 			nvmem-cell-names = "rtc_offset";
 		};
+
+		pmu_temperature {
+			compatible = "apple,t6000-smc-pmu-temp";
+		};
 	};
 
 	smc_mbox: mbox@290408000 {
diff --git a/drivers/hwmon/Kconfig b/drivers/hwmon/Kconfig
--- a/drivers/hwmon/Kconfig
+++ b/drivers/hwmon/Kconfig
@@ -409,6 +409,13 @@
 	  and power sensors available on ARM Ltd's SCP based platforms. The
 	  actual number and type of sensors exported depend on the platform.
 
+config SENSORS_MACSMC_PMU_TEMP
+	tristate "Apple Silicon SMC PMU temperature sensors"
+	depends on MFD_MACSMC
+	help
+	  Experimental T600x PMU die-temperature driver. It exports one
+	  Core N channel for each CPU and maps it to a derived PMU tdie key.
+
 config SENSORS_ASB100
 	tristate "Asus ASB100 Bach"
 	depends on (X86 || COMPILE_TEST) && I2C
diff --git a/drivers/hwmon/Makefile b/drivers/hwmon/Makefile
--- a/drivers/hwmon/Makefile
+++ b/drivers/hwmon/Makefile
@@ -49,7 +49,8 @@
 obj-$(CONFIG_SENSORS_AHT10)	+= aht10.o
 obj-$(CONFIG_SENSORS_APPLESMC)	+= applesmc.o
 obj-$(CONFIG_SENSORS_AQUACOMPUTER_D5NEXT) += aquacomputer_d5next.o
 obj-$(CONFIG_SENSORS_ARM_SCMI)	+= scmi-hwmon.o
+obj-$(CONFIG_SENSORS_MACSMC_PMU_TEMP) += macsmc-pmu-temp.o
 obj-$(CONFIG_SENSORS_ARM_SCPI)	+= scpi-hwmon.o
 obj-$(CONFIG_SENSORS_AS370)	+= as370-hwmon.o
 obj-$(CONFIG_SENSORS_ASC7621)	+= asc7621.o
diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -52,6 +52,7 @@
 	MFD_CELL_OF("macsmc-hwmon", NULL, NULL, 0, 0, "apple,smc-hwmon"),
 	MFD_CELL_OF("macsmc-reboot", NULL, NULL, 0, 0, "apple,smc-reboot"),
 	MFD_CELL_OF("macsmc-rtc", NULL, NULL, 0, 0, "apple,smc-rtc"),
+	MFD_CELL_OF("macsmc-pmu-temp", NULL, NULL, 0, 0, "apple,t6000-smc-pmu-temp"),
 };
 
 static int apple_smc_cmd_locked(struct apple_smc *smc, u64 cmd, u64 arg,
diff --git a/drivers/hwmon/macsmc-pmu-temp.c b/drivers/hwmon/macsmc-pmu-temp.c
new file mode 100644
--- /dev/null
+++ b/drivers/hwmon/macsmc-pmu-temp.c
@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/bitops.h>
+#include <linux/cpumask.h>
+#include <linux/device.h>
+#include <linux/hwmon.h>
+#include <linux/limits.h>
+#include <linux/mfd/macsmc.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#define PMU_TEMP_PROBES_PER_CORE	3
+#define PMU_TEMP_MAX_CORES		10
+#define PMU_TEMP_LABEL_LEN		24
+
+struct pmu_temp {
+	struct apple_smc *smc;
+	unsigned int ncores;
+	unsigned int nr_channels; /* ncores averaged + ncores*PROBES_PER_CORE raw */
+	smc_key (*channel_keys)[PMU_TEMP_PROBES_PER_CORE];
+	char (*labels)[PMU_TEMP_LABEL_LEN];
+	u32 *config;
+	struct hwmon_channel_info channel_info;
+	const struct hwmon_channel_info *info[2];
+	struct hwmon_chip_info chip_info;
+};
+
+/*
+ * Confirmed by direct SMC query on real T6000 (M1 Pro, 8P+2E) hardware --
+ * not derived from IOHID LocationIDs the way the first cut of this driver
+ * was. There is no key named "TP0b".."TPab" or "TP1l"/"TP2l"/"TP1g"/"TP2g"/
+ * "TP3g" anywhere in this chip's ~2179-entry SMC key table (verified with a
+ * small out-of-tree debugfs dump of every key/type/value via macsmc's own
+ * exported API). What does exist is a 30-key "Tp0*" family (lowercase 'p'),
+ * all type "flt", which decomposes into exactly 10 groups of 3
+ * lexicographically-consecutive suffix characters with one character
+ * skipped between groups:
+ *   0-2, 4-6, 8-A, C-E, G-I, K-M, O-Q, S-U, W-Y, a-c
+ * All 30 keys rise together (+7..+13C) under an all-core load relative to
+ * idle, while known chassis/peripheral sensors (battery, NAND, charge
+ * regulator) barely move under the same load -- confirming this family is
+ * CPU/SoC-die-adjacent. 10 groups of 3 probes matches this chip's 8P+2E
+ * core count.
+ *
+ * NOT yet confirmed: which group corresponds to which specific logical
+ * CPU. apple_smc_get_key_by_index() returns keys in ascending sorted order
+ * (see macsmc.h), and these 10 groups appear in that same ascending order,
+ * so bucketing-every-3-in-order is the most defensible default absent
+ * further data -- but it is an ordinal assumption, not a verified
+ * core-to-group mapping. A clean single-core-pinned thermal sweep (machine
+ * otherwise idle, no concurrent builds) would be needed to confirm or
+ * correct the exact assignment.
+ *
+ * Userspace tools that build a per-core view (e.g. btop, which this driver
+ * is written for -- see commit message) expect exactly one value per
+ * "Core N" label; feeding them 3 identically-labeled entries per core would
+ * produce duplicate/nondeterministic display rather than useful data. So
+ * each core's 3 probes are also averaged into a single "Core N" channel
+ * for that purpose, while the 3 raw per-probe readings remain separately
+ * available as "Core N (Sensor M)" for anyone who wants them.
+ */
+static const char pmu_tdie_suffixes[PMU_TEMP_MAX_CORES][PMU_TEMP_PROBES_PER_CORE] = {
+	{ '0', '1', '2' },
+	{ '4', '5', '6' },
+	{ '8', '9', 'A' },
+	{ 'C', 'D', 'E' },
+	{ 'G', 'H', 'I' },
+	{ 'K', 'L', 'M' },
+	{ 'O', 'P', 'Q' },
+	{ 'S', 'T', 'U' },
+	{ 'W', 'X', 'Y' },
+	{ 'a', 'b', 'c' },
+};
+
+static long float_to_mc(u32 raw)
+{
+	u64 mantissa = (raw & 0x7fffff) + BIT(23);
+	int exponent = ((raw >> 23) & 0xff) - 150;
+	long result;
+
+	mantissa *= 1000;
+	if (fls64(mantissa) + exponent > sizeof(long) * BITS_PER_BYTE - 1)
+		result = LONG_MAX;
+	else if (exponent < 0)
+		result = (mantissa + BIT_ULL(-exponent - 1)) >> -exponent;
+	else
+		result = mantissa << exponent;
+	return (raw & BIT(31)) ? -result : result;
+}
+
+static umode_t pmu_temp_visible(const void *data, enum hwmon_sensor_types type,
+				u32 attr, int channel)
+{
+	const struct pmu_temp *pmu = data;
+
+	if (type != hwmon_temp || channel >= pmu->nr_channels)
+		return 0;
+	return (attr == hwmon_temp_input || attr == hwmon_temp_label) ? 0444 : 0;
+}
+
+static int pmu_temp_read_one(struct pmu_temp *pmu, smc_key key, long *val)
+{
+	u32 raw;
+	long mc;
+
+	if (apple_smc_read_u32(pmu->smc, key, &raw))
+		return -EIO;
+	mc = float_to_mc(raw);
+	if (mc < -50000 || mc > 150000)
+		return -ERANGE;
+	*val = mc;
+	return 0;
+}
+
+static int pmu_temp_read(struct device *dev, enum hwmon_sensor_types type,
+			 u32 attr, int channel, long *val)
+{
+	struct pmu_temp *pmu = dev_get_drvdata(dev);
+	unsigned int idx, core, probe, j, n = 0;
+	long sum = 0;
+
+	if (type != hwmon_temp || attr != hwmon_temp_input ||
+	    channel >= pmu->nr_channels)
+		return -EOPNOTSUPP;
+
+	if (channel >= pmu->ncores) {
+		idx = channel - pmu->ncores;
+		core = idx / PMU_TEMP_PROBES_PER_CORE;
+		probe = idx % PMU_TEMP_PROBES_PER_CORE;
+		return pmu_temp_read_one(pmu, pmu->channel_keys[core][probe], val);
+	}
+
+	for (j = 0; j < PMU_TEMP_PROBES_PER_CORE; j++) {
+		long mc;
+
+		if (pmu_temp_read_one(pmu, pmu->channel_keys[channel][j], &mc))
+			continue;
+		sum += mc;
+		n++;
+	}
+	if (!n)
+		return -EIO;
+	*val = sum / n;
+	return 0;
+}
+
+static int pmu_temp_read_string(struct device *dev, enum hwmon_sensor_types type,
+				u32 attr, int channel, const char **str)
+{
+	struct pmu_temp *pmu = dev_get_drvdata(dev);
+
+	if (type != hwmon_temp || attr != hwmon_temp_label ||
+	    channel >= pmu->nr_channels)
+		return -EOPNOTSUPP;
+	*str = pmu->labels[channel];
+	return 0;
+}
+
+static const struct hwmon_ops pmu_temp_ops = {
+	.is_visible = pmu_temp_visible,
+	.read = pmu_temp_read,
+	.read_string = pmu_temp_read_string,
+};
+
+static bool pmu_temp_is_float(struct apple_smc *smc, smc_key key)
+{
+	struct apple_smc_key_info info;
+
+	return !apple_smc_get_key_info(smc, key, &info) &&
+		info.size == sizeof(u32) &&
+		info.type_code == __SMC_KEY('f', 'l', 't', ' ');
+}
+
+static int pmu_temp_probe(struct platform_device *pdev)
+{
+	struct pmu_temp *pmu;
+	struct device *hwmon;
+	unsigned int ncores, i, j;
+
+	pmu = devm_kzalloc(&pdev->dev, sizeof(*pmu), GFP_KERNEL);
+	if (!pmu)
+		return -ENOMEM;
+	pmu->smc = dev_get_drvdata(pdev->dev.parent);
+	if (!pmu->smc)
+		return -EPROBE_DEFER;
+
+	/* Apple Silicon has one hardware thread per CPU core. */
+	ncores = num_possible_cpus();
+	if (ncores > PMU_TEMP_MAX_CORES)
+		ncores = PMU_TEMP_MAX_CORES;
+	if (!ncores)
+		return -ENODEV;
+	pmu->ncores = ncores;
+	pmu->nr_channels = ncores + ncores * PMU_TEMP_PROBES_PER_CORE;
+
+	pmu->channel_keys = devm_kcalloc(&pdev->dev, ncores,
+					 sizeof(*pmu->channel_keys), GFP_KERNEL);
+	pmu->labels = devm_kcalloc(&pdev->dev, pmu->nr_channels,
+				   sizeof(*pmu->labels), GFP_KERNEL);
+	pmu->config = devm_kcalloc(&pdev->dev, pmu->nr_channels + 1,
+				   sizeof(*pmu->config), GFP_KERNEL);
+	if (!pmu->channel_keys || !pmu->labels || !pmu->config)
+		return -ENOMEM;
+
+	for (i = 0; i < ncores; i++) {
+		bool any = false;
+
+		for (j = 0; j < PMU_TEMP_PROBES_PER_CORE; j++) {
+			smc_key key = __SMC_KEY('T', 'p', '0', pmu_tdie_suffixes[i][j]);
+
+			pmu->channel_keys[i][j] = key;
+			if (pmu_temp_is_float(pmu->smc, key))
+				any = true;
+		}
+		if (!any)
+			return -ENODEV;
+		snprintf(pmu->labels[i], PMU_TEMP_LABEL_LEN, "Core %u", i);
+		pmu->config[i] = HWMON_T_INPUT | HWMON_T_LABEL;
+	}
+
+	for (i = 0; i < ncores; i++) {
+		for (j = 0; j < PMU_TEMP_PROBES_PER_CORE; j++) {
+			unsigned int chan = ncores + i * PMU_TEMP_PROBES_PER_CORE + j;
+
+			snprintf(pmu->labels[chan], PMU_TEMP_LABEL_LEN,
+				 "Core %u (Sensor %u)", i, j + 1);
+			pmu->config[chan] = HWMON_T_INPUT | HWMON_T_LABEL;
+		}
+	}
+
+	pmu->channel_info.type = hwmon_temp;
+	pmu->channel_info.config = pmu->config;
+	pmu->info[0] = &pmu->channel_info;
+	pmu->chip_info.ops = &pmu_temp_ops;
+	pmu->chip_info.info = pmu->info;
+	hwmon = devm_hwmon_device_register_with_info(&pdev->dev, "macsmc_pmu_temp",
+						     pmu, &pmu->chip_info, NULL);
+	return PTR_ERR_OR_ZERO(hwmon);
+}
+
+static const struct of_device_id pmu_temp_of_match[] = {
+	{ .compatible = "apple,t6000-smc-pmu-temp" }, {}
+};
+MODULE_DEVICE_TABLE(of, pmu_temp_of_match);
+
+static struct platform_driver pmu_temp_driver = {
+	.probe = pmu_temp_probe,
+	.driver = { .name = "macsmc-pmu-temp", .of_match_table = pmu_temp_of_match },
+};
+module_platform_driver(pmu_temp_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Apple Silicon SMC PMU temperature sensors");
