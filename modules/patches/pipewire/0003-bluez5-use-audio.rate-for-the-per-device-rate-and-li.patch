 spa/plugins/bluez5/bluez5-dbus.c   | 70 +++++++++++++++++++++++++++++-
 spa/plugins/bluez5/bluez5-device.c | 61 ++++++++++++++++++++++++--
 spa/plugins/bluez5/defs.h          |  1 +
