From 1cc1f633c431a643a98d2d646cbf76a0d554b257 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Tue, 15 Sep 2026 20:27:38 -0400
Subject: [PATCH 040/100] scaletempo: discard what is held between strides on a
 flush

The filter keeps up to a queue of audio - fifty milliseconds at the
default stride - plus the tail of the last stride to blend into the next
one. It registered no flush callback, so both survived a seek: audio from
before the seek went out after it, blended into what followed.

Every other audio filter that holds state across blocks implements this.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/audio_filter/scaletempo.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/modules/audio_filter/scaletempo.c b/modules/audio_filter/scaletempo.c
index 6bd768f877..c3433c3d73 100644
--- a/modules/audio_filter/scaletempo.c
+++ b/modules/audio_filter/scaletempo.c
@@ -413,6 +413,26 @@ static int reinit_buffers( filter_t *p_filter )
     return VLC_SUCCESS;
 }
 
+/*****************************************************************************
+ * Flush: discard the audio held between strides
+ *****************************************************************************/
+static void Flush( filter_t *p_filter )
+{
+    filter_sys_t *p = p_filter->p_sys;
+
+    p->bytes_queued        = 0;
+    p->bytes_to_slide      = 0;
+    p->frames_stride_error = 0;
+
+    /* What the overlap buffer holds is from before the discontinuity; blending
+     * the audio that follows into it would splice the two together. */
+    p->overlap_primed      = false;
+
+#ifdef PITCH_SHIFTER
+    filter_Flush( p->resampler );
+#endif
+}
+
 /*****************************************************************************
  * Open: initialize as "audio filter"
  *****************************************************************************/
@@ -465,6 +485,7 @@ static int Open( vlc_object_t *p_this )
     aout_FormatPrepare(&p_filter->fmt_in.audio);
     p_filter->fmt_out.audio = p_filter->fmt_in.audio;
     p_filter->pf_audio_filter = DoWork;
+    p_filter->pf_flush = Flush;
 
     return VLC_SUCCESS;
 }
