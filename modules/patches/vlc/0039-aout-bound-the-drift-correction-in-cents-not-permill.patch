diff --git a/src/audio_output/dec.c b/src/audio_output/dec.c
index 27aecc3bd5..74eff71ce8 100644
--- a/src/audio_output/dec.c
+++ b/src/audio_output/dec.c
@@ -353,7 +353,7 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
      * instead. There is no derivative term: the drift is quantised by whatever
      * granularity the output reports its delay with, and differentiating that
      * yields noise rather than a trend. */
-    const float max = aout_FiltersGetMaxResampling (owner->filters);
+    const float max = aout_FiltersGetMaxDetune (owner->filters);
 
     if (max <= 0.f)
         return; /* correction by resampling is disabled */
@@ -369,26 +369,12 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
         return;
     }
 
-    float correction = owner->sync.drift_kp * (drift / (float)CLOCK_FREQ)
-                       + owner->sync.drift_integral;
-    bool bound = false;
+    const float commanded = owner->sync.drift_kp * (drift / (float)CLOCK_FREQ)
+                            + owner->sync.drift_integral;
+    const float applied = aout_FiltersSetDetune (owner->filters, commanded);
+    const bool bound = fabsf (applied) >= max;
 
-    if (correction > +max)
-    {
-        correction = +max;
-        bound = true;
-    }
-    else if (correction < -max)
-    {
-        correction = -max;
-        bound = true;
-    }
-
-    /* Conditional integration: pinned at the bound, the integral can no longer
-     * change the output, and whatever it piles up there only has to be unwound
-     * before the correction can come off the bound again. */
-    if (owner->sync.update != VLC_TICK_INVALID
-     && !(bound && (correction > 0.f) == (drift > 0)))
+    if (owner->sync.update != VLC_TICK_INVALID)
     {
         vlc_tick_t dt = now - owner->sync.update;
 
@@ -399,9 +385,22 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
 
         if (dt > 0)
         {
+            const float seconds = dt / (float)CLOCK_FREQ;
             float i = owner->sync.drift_integral
                       + owner->sync.drift_ki * (drift / (float)CLOCK_FREQ)
-                        * (dt / (float)CLOCK_FREQ);
+                        * seconds;
+
+            /* What went to the resampler is not what was asked of it: it is a
+             * whole number of Hz, and it was clamped to the bound. Integrating
+             * against what was asked would have the integral answer for a
+             * correction that was never made - winding up against the bound,
+             * and quietly accumulating the rounding either side of it. Feed
+             * the difference back instead, over the time constant the gains
+             * already imply, so the integral tracks what the output is really
+             * doing. */
+            if (owner->sync.drift_kp > 0.f)
+                i += (applied - commanded)
+                     * (owner->sync.drift_ki / owner->sync.drift_kp) * seconds;
 
             /* The integral on its own may not ask for more than the bound. */
             owner->sync.drift_integral = (i > +max) ? +max
@@ -417,7 +416,6 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
                  bound ? "reached" : "left", drift);
     }
 
-    aout_FiltersSetResampling (owner->filters, correction);
 }
 
