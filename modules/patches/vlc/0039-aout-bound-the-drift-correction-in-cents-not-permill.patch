+++ b/src/audio_output/aout_internal.h
@@ -177,8 +177,8 @@ static inline void aout_SetWavePhysicalChannels(audio_sample_format_t *fmt)
 }
 
 /* From filters.c */
-float aout_FiltersGetMaxResampling (aout_filters_t *filters);
-void aout_FiltersSetResampling (aout_filters_t *filters, float ratio);
+float aout_FiltersGetMaxDetune (aout_filters_t *filters);
