From 2ead709e1f848b7038ce678e633b639fe66fa09f Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Tue, 15 Sep 2026 19:35:47 -0400
Subject: [PATCH 37/78] input: give the output the lead its device needs

The clock was rebased so the first sample fell due ten milliseconds out,
whatever the output was playing to. A device holding two tenths of a
second therefore got its first sample already late by the difference,
and the output skipped over that much audio to catch up.

Add the device latency to the lead, so the sample arrives in time to be
heard when it is due. Video shifts with it, so sync is unaffected.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/input/es_out.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/input/es_out.c b/src/input/es_out.c
index ffaac46e3d..02468256ff 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -48,6 +48,7 @@
 #include "info.h"
 #include "item.h"
 
+#include "../audio_output/aout_internal.h"
 #include "../stream_output/stream_output.h"
 
 #include <vlc_iso_lang.h>
@@ -743,7 +744,19 @@ static void EsOutDecodersStopBuffering( es_out_t *out, bool b_forced )
     input_resource_TerminateVout( input_priv(p_sys->p_input)->p_resource );
 
     /* */
-    const vlc_tick_t i_wakeup_delay = 10*1000; /* FIXME CLEANUP thread wake up time*/
+    vlc_tick_t i_wakeup_delay = 10*1000; /* FIXME CLEANUP thread wake up time*/
+
+    /* The first sample has to reach the device early enough for it to have
+     * come out by the time it is due, or it is born late and the output has
+     * to skip over the difference. */
+    audio_output_t *p_aout =
+        input_resource_HoldAout( input_priv(p_sys->p_input)->p_resource );
+    if( p_aout != NULL )
+    {
+        i_wakeup_delay += aout_DecGetLatency( p_aout );
+        vlc_object_release( p_aout );
+    }
+
     const vlc_tick_t i_current_date = p_sys->b_paused ? p_sys->i_pause_date : mdate();
 
     input_clock_ChangeSystemOrigin( p_sys->p_pgrm->p_clock, true,
