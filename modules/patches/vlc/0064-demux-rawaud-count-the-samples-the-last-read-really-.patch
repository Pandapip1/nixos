From 298bbf89acb00bbe577fe12a3ec798495ad5325d Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Wed, 16 Sep 2026 03:33:17 -0400
Subject: [PATCH 064/105] demux: rawaud: count the samples the last read really
 brought back

The last read returns whatever is left of the file, which is short of a
whole frame unless the two divide, and the date accumulator is advanced
by a whole frame regardless. The block carries no length either, so the
end of the stream reads up to a frame later than it is - a hole at every
loop when the item is repeated in place, filled with silence.

Count what came back and set the length from it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/rawaud.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/modules/demux/rawaud.c b/modules/demux/rawaud.c
index 33779ce870..789106c428 100644
--- a/modules/demux/rawaud.c
+++ b/modules/demux/rawaud.c
@@ -257,13 +257,21 @@ static int Demux( demux_t *p_demux )
         return 0;
     }
 
-    p_block->i_dts = p_block->i_pts = VLC_TICK_0 + date_Get( &p_sys->pts );
+    /* The last read is short of a whole frame whenever the file does not
+     * divide by it. Count what came back, and say how far it reaches: a
+     * reader left to work that out from the frame before it puts the end of
+     * the stream up to a frame late. */
+    unsigned i_samples = p_block->i_buffer * p_sys->i_frame_samples
+                       / p_sys->i_frame_size;
+    const vlc_tick_t i_date = date_Get( &p_sys->pts );
+
+    p_block->i_dts = p_block->i_pts = VLC_TICK_0 + i_date;
+    p_block->i_nb_samples = i_samples;
+    p_block->i_length = date_Increment( &p_sys->pts, i_samples ) - i_date;
 
     es_out_SetPCR( p_demux->out, p_block->i_pts );
     es_out_Send( p_demux->out, p_sys->p_es, p_block );
 
-    date_Increment( &p_sys->pts, p_sys->i_frame_samples );
-
     return 1;
 }
 
