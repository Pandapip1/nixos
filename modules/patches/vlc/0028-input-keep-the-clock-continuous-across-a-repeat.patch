From a2694191d7aeef299009b00a5dfafebd39af2dca Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 14 Sep 2026 01:29:58 -0400
Subject: [PATCH 28/44] input: keep the clock continuous across a repeat

Not discarding the decoded data was only half of it. The repeat still
went through the ordinary reposition, which resets the clock reference
and re-enters buffering. When buffering ends, EsOutDecodersStopBuffering()
rebases the clock onto the current date minus the buffering duration, so
the new pass converts to system dates that have already gone by - about a
second of them. aout_DecSynchronize() sees that as lateness and calls
aout_OutputFlush(), which throws away exactly the data the previous
commit kept. Measured: the queued audio was preserved and then dropped
anyway, with the reported lateness growing pass over pass, from 200 ms to
over a second.

The stream clock restarts from zero on a repeat while the system clock
carries on, so what is needed is to move the stream side of the reference
back by the pass just played, not to reset it. Add
input_clock_ChangeStreamOrigin() for that - the counterpart of
input_clock_ChangeSystemOrigin() on the other axis - and use the last PCR
of the pass as the amount.

Skip the re-buffering too: it would stall the decoders that were
deliberately left loaded, and rebase the clock on the way out, undoing
the above.
---
 src/input/clock.c  | 15 +++++++++++++++
 src/input/clock.h  | 13 +++++++++++++
 src/input/es_out.c | 34 +++++++++++++++++++++++++++-------
 3 files changed, 55 insertions(+), 7 deletions(-)

diff --git a/src/input/clock.c b/src/input/clock.c
index 3099cfeec5..df2a9a0575 100644
--- a/src/input/clock.c
+++ b/src/input/clock.c
@@ -523,6 +523,21 @@ void input_clock_ChangeSystemOrigin( input_clock_t *cl, bool b_absolute, vlc_tic
     vlc_mutex_unlock( &cl->lock );
 }
 
+void input_clock_ChangeStreamOrigin( input_clock_t *cl, vlc_tick_t i_duration )
+{
+    vlc_mutex_lock( &cl->lock );
+
+    assert( cl->b_has_reference );
+
+    /* Move the stream side of the reference back, so that a stream date of 0
+     * in the new pass converts to the system date that i_duration used to.
+     * The system side is untouched: wall clock time does not restart. */
+    cl->ref.i_stream  -= i_duration;
+    cl->last.i_stream -= i_duration;
+
+    vlc_mutex_unlock( &cl->lock );
+}
+
 void input_clock_GetSystemOrigin( input_clock_t *cl, vlc_tick_t *pi_system, vlc_tick_t *pi_delay )
 {
     vlc_mutex_lock( &cl->lock );
diff --git a/src/input/clock.h b/src/input/clock.h
index 67a9cf2a24..1357683215 100644
--- a/src/input/clock.h
+++ b/src/input/clock.h
@@ -94,6 +94,19 @@ void    input_clock_GetSystemOrigin( input_clock_t *, vlc_tick_t *pi_system, vlc
  */
 void    input_clock_ChangeSystemOrigin( input_clock_t *, bool b_absolute, vlc_tick_t i_system );
 
+/**
+ * This function rebases the stream side of the reference point, moving it back
+ * by i_duration (a valid reference point must have been set).
+ *
+ * It is the counterpart of input_clock_ChangeSystemOrigin() on the other axis,
+ * and exists for repeating an item: the stream clock starts over from zero
+ * while the system clock carries on, so timestamps from the new pass must map
+ * to system dates that continue where the previous pass left off, rather than
+ * to dates that have already gone by. Resetting the clock instead would make
+ * the new pass look late by the length of the pass just played.
+ */
+void    input_clock_ChangeStreamOrigin( input_clock_t *, vlc_tick_t i_duration );
+
 /**
  * This function converts a pair of timestamp from stream clock to system clock.
  *
diff --git a/src/input/es_out.c b/src/input/es_out.c
index 2477c45b46..e056b1dc61 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -650,16 +650,36 @@ static void EsOutChangePosition( es_out_t *out, bool b_flush )
     }
 
     for( int i = 0; i < p_sys->i_pgrm; i++ ) {
-        input_clock_Reset( p_sys->pgrm[i]->p_clock );
-        p_sys->pgrm[i]->i_last_pcr = VLC_TICK_INVALID;
+        es_out_pgrm_t *p_pgrm = p_sys->pgrm[i];
+
+        /* Repeating the item restarts the stream clock from zero while the
+         * system clock carries on. Resetting the reference would make the new
+         * pass convert to system dates that have already gone by - the output
+         * then reports it as lateness and flushes, which throws away the very
+         * data that was kept above. Move the stream side of the reference back
+         * by the pass just played instead, so the new one converts to dates
+         * that follow on. */
+        if( !b_flush && p_pgrm->i_last_pcr != VLC_TICK_INVALID )
+            input_clock_ChangeStreamOrigin( p_pgrm->p_clock,
+                                            p_pgrm->i_last_pcr );
+        else
+            input_clock_Reset( p_pgrm->p_clock );
+
+        p_pgrm->i_last_pcr = VLC_TICK_INVALID;
     }
 
-    p_sys->b_buffering = true;
-    p_sys->i_buffering_extra_initial = 0;
-    p_sys->i_buffering_extra_stream = 0;
-    p_sys->i_buffering_extra_system = 0;
+    /* Buffering again would stall the decoders and, once it ended, rebase the
+     * clock onto the current date - undoing the rebasing just done. There is
+     * nothing to buffer for anyway: the decoders were left loaded. */
+    if( b_flush )
+    {
+        p_sys->b_buffering = true;
+        p_sys->i_buffering_extra_initial = 0;
+        p_sys->i_buffering_extra_stream = 0;
+        p_sys->i_buffering_extra_system = 0;
+        p_sys->i_prev_stream_level = -1;
+    }
     p_sys->i_preroll_end = -1;
-    p_sys->i_prev_stream_level = -1;
 }
 
 
