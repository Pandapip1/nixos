From a92f686ef920a9b9cf5bff3ecd7d9987d204db51 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 14 Sep 2026 19:46:22 -0400
Subject: [PATCH 33/34] aout: correct the timeline without stopping the sound

Two halves of the same thing.

The resampler correction was dropped by aout_DecFlush(), by the late and
early paths, and by a pause. The correction describes the output device,
and none of those events move it: dropping it makes every pass of a
repeat start from nothing and converge all over again, which is the very
thing it exists to spare. Keep it, and give it up only when playback
actually stops - so aout_StopResampling() goes altogether.

Lateness was answered by flushing the output. That throws away everything
queued - a second or more of audio - which is heard as a hole, and leaves
the output to start again from nothing: on a device with a real latency
that means corking it, losing the settled clock and paying the start-up
cost over again, all to correct an offset. Let what is queued play out
and drop as much from what follows instead. The material jumps by the
same amount; the sound does not stop. Seeking the output backwards would
be the tidier answer, and the comment here has long noted it is not
portable - skipping forward in what has not been written yet asks nothing
of the output at all.

One jump at a time. It shortens what is still to come, not what the
output already holds, so the drift goes on reading high until that has
played out, and asking again on every buffer meanwhile skips the same
lateness over and over: doing so cost a quarter of the audio and fired
fifty times in fifteen seconds, against four when held to one.

Captured from the sink's monitor, a four second sweep on repeat went from

  0.15-4.15 audio | 3.9s of silence | 8.05-12.05 audio

to running continuously from 0.15 to 7.45, straight through the repeat.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/audio_output/aout_internal.h |   2 +
 src/audio_output/dec.c           | 104 ++++++++++++++++++++++---------
 2 files changed, 75 insertions(+), 31 deletions(-)

diff --git a/src/audio_output/aout_internal.h b/src/audio_output/aout_internal.h
index ee40a338a8..b154fd2061 100644
--- a/src/audio_output/aout_internal.h
+++ b/src/audio_output/aout_internal.h
@@ -78,6 +78,8 @@ typedef struct
     struct
     {
         vlc_tick_t end; /**< Last seen PTS */
+        vlc_tick_t skip; /**< Material still to be jumped over */
+        vlc_tick_t skip_settles; /**< When a jump can have taken effect */
         unsigned resamp_start_drift; /**< Resampler drift absolute value */
         int resamp_type; /**< Resampler mode (FIXME: redundant / resampling) */
         bool discontinuity;
diff --git a/src/audio_output/dec.c b/src/audio_output/dec.c
index 08802319d9..088aa1b263 100644
--- a/src/audio_output/dec.c
+++ b/src/audio_output/dec.c
@@ -110,6 +110,8 @@ error:
     owner->sync.end = VLC_TICK_INVALID;
     owner->sync.resamp_type = AOUT_RESAMPLING_NONE;
     owner->sync.discontinuity = true;
+    owner->sync.skip = 0;
+    owner->sync.skip_settles = 0;
     aout_OutputUnlock (p_aout);
 
     atomic_init (&owner->buffers_lost, 0);
@@ -205,12 +207,37 @@ void aout_RequestRestart (audio_output_t *aout, unsigned mode)
  * Buffer management
  */
 
-static void aout_StopResampling (audio_output_t *aout)
+/**
+ * Takes i_length off the front of a buffer, or all of it if it is shorter.
+ * \return what is left of the buffer, or NULL if none of it is.
+ */
+static block_t *aout_DecSkipBuffer (audio_output_t *aout, block_t *block,
+                                    vlc_tick_t *restrict skip)
 {
     aout_owner_t *owner = aout_owner (aout);
+    const audio_sample_format_t *fmt = &owner->mixer_format;
+    size_t frames, bytes;
 
-    owner->sync.resamp_type = AOUT_RESAMPLING_NONE;
-    aout_FiltersAdjustResampling (owner->filters, 0);
+    if (block->i_length <= *skip)
+    {
+        *skip -= block->i_length;
+        block_Release (block);
+        return NULL;
+    }
+
+    frames = (fmt->i_rate * *skip) / CLOCK_FREQ;
+    if (frames == 0 || frames >= block->i_nb_samples)
+        return block;
+
+    bytes = frames * fmt->i_bytes_per_frame / fmt->i_frame_length;
+    block->p_buffer += bytes;
+    block->i_buffer -= bytes;
+    block->i_nb_samples -= frames;
+    block->i_pts += *skip;
+    block->i_dts += *skip;
+    block->i_length -= *skip;
+    *skip = 0;
+    return block;
 }
 
 static void aout_DecSilence (audio_output_t *aout, vlc_tick_t length, vlc_tick_t pts)
@@ -257,7 +284,10 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
      */
     if (aout_OutputTimeGet (aout, &drift) != 0)
         return; /* nothing can be done if timing is unknown */
-    drift += mdate () - dec_pts;
+
+    const vlc_tick_t delay = drift, now = mdate ();
+
+    drift += now - dec_pts;
 
     /* Late audio output.
      * This can happen due to insufficient caching, scheduling jitter
@@ -268,22 +298,28 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
     if (drift > (owner->sync.discontinuity ? 0
                   : +3 * input_rate * AOUT_MAX_PTS_DELAY / INPUT_RATE_DEFAULT))
     {
-        if (!owner->sync.discontinuity)
-            msg_Warn (aout, "playback way too late (%"PRId64"): "
-                      "flushing buffers", drift);
-        else
-            msg_Dbg (aout, "playback too late (%"PRId64"): "
-                     "flushing buffers", drift);
-        aout_OutputFlush (aout, false);
-
-        aout_StopResampling (aout);
-        owner->sync.end = VLC_TICK_INVALID;
-        owner->sync.discontinuity = true;
-
-        /* Now the output might be too early... Recheck. */
-        if (aout_OutputTimeGet (aout, &drift) != 0)
-            return; /* nothing can be done if timing is unknown */
-        drift += mdate () - dec_pts;
+        /* Jump over it rather than emptying the output. Flushing throws away
+         * everything queued - a second or more - which is heard as a hole,
+         * and leaves the output to start from nothing again. Letting what is
+         * queued play out and dropping as much from what follows costs a jump
+         * in the material instead of a gap in the sound.
+         *
+         * Only one at a time: the jump shortens what is still to come, not
+         * what the output already holds, so the drift keeps reading high
+         * until that has played out. */
+        if (now >= owner->sync.skip_settles)
+        {
+            if (!owner->sync.discontinuity)
+                msg_Warn (aout, "playback way too late (%"PRId64"): "
+                          "jumping ahead", drift);
+            else
+                msg_Dbg (aout, "playback too late (%"PRId64"): "
+                         "jumping ahead", drift);
+            owner->sync.skip += drift;
+            owner->sync.skip_settles = now + delay;
+            owner->sync.end = VLC_TICK_INVALID;
+        }
+        return;
     }
 
     /* Early audio output.
@@ -296,7 +332,6 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
                       "playing silence", drift);
         aout_DecSilence (aout, -drift, dec_pts);
 
-        aout_StopResampling (aout);
         owner->sync.discontinuity = true;
         drift = 0;
     }
@@ -331,11 +366,17 @@ static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
         return; /* Everything is fine. Nothing to do. */
 
     if (llabs (drift) > 2 * owner->sync.resamp_start_drift)
-    {   /* If the drift is ever increasing, then something is seriously wrong.
-         * Cease resampling and hope for the best. */
+    {   /* Resampling is not closing the gap - it is bounded, and cannot pull
+         * back more than a few permille. Hand the difference to the skip,
+         * which jumps over it in one go, and keep the correction: it
+         * describes the device and is still right. */
         msg_Warn (aout, "timing screwed (drift: %"PRId64" us): "
-                  "stopping resampling", drift);
-        aout_StopResampling (aout);
+                  "jumping instead", drift);
+        if (drift > 0 && mdate () >= owner->sync.skip_settles)
+        {
+            owner->sync.skip += drift;
+            owner->sync.skip_settles = mdate () + delay;
+        }
         return;
     }
 
@@ -409,6 +450,13 @@ int aout_DecPlay (audio_output_t *aout, block_t *block, int input_rate)
     /* Drift correction */
     aout_DecSynchronize (aout, block->i_pts, input_rate);
 
+    if (unlikely(owner->sync.skip > 0))
+    {
+        block = aout_DecSkipBuffer (aout, block, &owner->sync.skip);
+        if (block == NULL)
+            goto lost;
+    }
+
     /* Output */
     owner->sync.end = block->i_pts + block->i_length + 1;
     owner->sync.discontinuity = false;
@@ -448,9 +496,6 @@ void aout_DecChangePause (audio_output_t *aout, bool paused, vlc_tick_t date)
     }
     if (owner->mixer_format.i_format)
     {
-        /* The reference it was derived from does not survive the pause. */
-        if (paused)
-            aout_StopResampling (aout);
         aout_OutputPause (aout, paused, date);
     }
     aout_OutputUnlock (aout);
@@ -473,9 +518,6 @@ void aout_DecFlush (audio_output_t *aout, bool wait)
         else
             aout_FiltersFlush (owner->filters);
         aout_OutputFlush (aout, wait);
-
-        /* Drop the correction with the data it was computed for. */
-        aout_StopResampling (aout);
     }
 
     /* The offset a flush leaves behind is not drift; do not resample to
