From 7a7868ab718fe5a53eda88dec38812c5c332463e Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Sun, 13 Sep 2026 22:45:35 -0400
Subject: [PATCH 25/26] pulse: do not restart the start timer once it is
 scheduled

stream_start() is called from the latency callback and from Play(), both
whenever the stream is still corked, so it runs repeatedly before the
deferred start it scheduled has had a chance to fire. Each call cancelled
the pending trigger and recomputed the schedule from the latency the sink
reports at that moment. That latency grows as the buffer fills, so the
recomputed answer is routinely negative - "already late" - and a start
that had been correctly scheduled is replaced by an immediate late one:

    deferring start (9969 us)
    starting late (-13389 us)

Note the absence of "starting deferred" between those two: the timer never
fired, it was cancelled and superseded.

Return early when a trigger is already pending and let it fire. The paths
that invalidate the schedule - stream_stop() and Flush() - already clear
the trigger themselves.
---
 modules/audio_output/pulse.c | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/modules/audio_output/pulse.c b/modules/audio_output/pulse.c
index c27528a24f..74ed00b4fe 100644
--- a/modules/audio_output/pulse.c
+++ b/modules/audio_output/pulse.c
@@ -233,6 +233,16 @@ static void stream_start(pa_stream *s, audio_output_t *aout)
 
     assert (sys->first_pts != VLC_TICK_INVALID);
 
+    /* A start is already scheduled for the right moment. Recomputing it here
+     * would cancel that timer and start again from whatever the sink reports
+     * now; since the reported latency grows as the buffer fills, the fresh
+     * answer is routinely "you are already late", which turns a correctly
+     * scheduled start into an immediate late one. Let the timer fire.
+     * stream_stop() and Flush() clear the trigger when the schedule is no
+     * longer valid. */
+    if (sys->trigger != NULL)
+        return;
+
     delta = vlc_pa_get_latency(aout, sys->context, s);
     if (unlikely(delta == VLC_TICK_INVALID)) {
         /* The stream latency is how far ahead of the sink we have to start in
@@ -256,13 +266,7 @@ static void stream_start(pa_stream *s, audio_output_t *aout)
     }
     sys->start_tries = 0;
 
-    /* Only now that the start is actually going ahead: cancelling a pending
-     * trigger on a path that then defers would drop an already scheduled
-     * start without replacing it. */
-    if (sys->trigger != NULL) {
-        vlc_pa_rttime_free(sys->mainloop, sys->trigger);
-        sys->trigger = NULL;
-    }
+    assert (sys->trigger == NULL); /* guaranteed by the early return above */
 
     delta = (sys->first_pts - mdate()) - delta;
     if (delta > 0) {
