From 460b8d833f062bbbbf812bfd1b3534c73c1f6423 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 14 Sep 2026 01:18:13 -0400
Subject: [PATCH 24/50] input: do not discard decoded data when repeating an
 item

A repeat is a seek back to the start, so it went through the ordinary seek
path, whose first act is EsOutChangePosition() calling input_DecoderFlush()
on every elementary stream. For a move elsewhere that is right; for a
repeat it is exactly wrong. The decoded data is the tail of the pass still
playing, and is what would cover the gap while the demuxer starts over.

Discarding it empties the audio output, so the sink runs dry at every loop;
on PipeWire a drained sink is parked and has to be resumed, which is heard.

Add ES_OUT_SET_TIME_REPEAT, which repositions without flushing the
decoders, and use it when the seek came from MainLoopTryRepeat().

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/input/es_out.c           | 26 +++++++++++++++++++-------
 src/input/es_out.h           |  5 +++++
 src/input/es_out_timeshift.c | 10 ++++++++++
 src/input/input.c            | 13 +++++++++++--
 src/input/input_internal.h   |  2 ++
 5 files changed, 47 insertions(+), 9 deletions(-)

diff --git a/src/input/es_out.c b/src/input/es_out.c
index d64ce58ec2..4a4bd2a030 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -199,7 +199,7 @@ static void EsDeleteInfo( es_out_t *, es_out_id_t *es );
 static void EsUnselect( es_out_t *out, es_out_id_t *es, bool b_update );
 static void EsOutDecoderChangeDelay( es_out_t *out, es_out_id_t *p_es );
 static void EsOutDecodersChangePause( es_out_t *out, bool b_paused, vlc_tick_t i_date );
-static void EsOutChangePosition( es_out_t *out );
+static void EsOutChangePosition( es_out_t *out, bool b_flush );
 static void EsOutProgramChangePause( es_out_t *out, bool b_paused, vlc_tick_t i_date );
 static void EsOutProgramsChangeRate( es_out_t *out );
 static void EsOutDecodersStopBuffering( es_out_t *out, bool b_forced );
@@ -562,7 +562,7 @@ static void EsOutStopNextFrame( es_out_t *out )
     es_out_sys_t *p_sys = out->p_sys;
     assert( p_sys->p_next_frame_es != NULL );
     /* Flush every ES except the video one */
-    EsOutChangePosition( out );
+    EsOutChangePosition( out, true );
     p_sys->p_next_frame_es = NULL;
 }
 
@@ -618,7 +618,7 @@ static void EsOutChangeRate( es_out_t *out, int i_rate )
     EsOutProgramsChangeRate( out );
 }
 
-static void EsOutChangePosition( es_out_t *out )
+static void EsOutChangePosition( es_out_t *out, bool b_flush )
 {
     es_out_sys_t      *p_sys = out->p_sys;
 
@@ -628,7 +628,11 @@ static void EsOutChangePosition( es_out_t *out )
     {
         es_out_id_t *p_es = p_sys->es[i];
 
-        if( p_es->p_dec != NULL )
+        /* A repeat has nothing to discard: what is already decoded is what
+         * covers the gap while the demuxer starts over. Flushing it empties
+         * the audio output, and a sink left to run dry is parked and has to be
+         * resumed - which is audible. */
+        if( p_es->p_dec != NULL && b_flush )
         {
             input_DecoderFlush( p_es->p_dec );
             if( !p_sys->b_buffering )
@@ -638,7 +642,8 @@ static void EsOutChangePosition( es_out_t *out )
                     input_DecoderStartWait( p_es->p_dec_record );
             }
         }
-        p_es->i_pts_level = VLC_TICK_INVALID;
+        if( b_flush )
+            p_es->i_pts_level = VLC_TICK_INVALID;
     }
 
     for( int i = 0; i < p_sys->i_pgrm; i++ ) {
@@ -2573,7 +2578,7 @@ static int EsOutControlLocked( es_out_t *out, int i_query, va_list args )
 
     case ES_OUT_RESET_PCR:
         msg_Dbg( p_sys->p_input, "ES_OUT_RESET_PCR called" );
-        EsOutChangePosition( out );
+        EsOutChangePosition( out, true );
         return VLC_SUCCESS;
 
     case ES_OUT_SET_GROUP:
@@ -2813,11 +2818,18 @@ static int EsOutControlLocked( es_out_t *out, int i_query, va_list args )
         const vlc_tick_t i_date = va_arg( args, vlc_tick_t );
 
         assert( i_date == -1 );
-        EsOutChangePosition( out );
+        EsOutChangePosition( out, true );
 
         return VLC_SUCCESS;
     }
 
+    case ES_OUT_SET_TIME_REPEAT:
+        /* Same as ES_OUT_SET_TIME, but for a seek back to the start that
+         * repeats the item: keeping what is already decoded is what makes the
+         * loop inaudible. */
+        EsOutChangePosition( out, false );
+        return VLC_SUCCESS;
+
     case ES_OUT_SET_FRAME_NEXT:
         EsOutFrameNext( out );
         return VLC_SUCCESS;
diff --git a/src/input/es_out.h b/src/input/es_out.h
index f37f8945ed..04272df0f9 100644
--- a/src/input/es_out.h
+++ b/src/input/es_out.h
@@ -73,6 +73,7 @@ enum es_out_query_private_e
 
     /* Set a new time */
     ES_OUT_SET_TIME,                                /* arg1=vlc_tick_t          res=can fail */
+    ES_OUT_SET_TIME_REPEAT,                         /* no arg                   res=cannot fail */
 
     /* Set next frame */
     ES_OUT_SET_FRAME_NEXT,                          /*                          res=can fail */
@@ -136,6 +137,10 @@ static inline int es_out_SetRate( es_out_t *p_out, int i_source_rate, int i_rate
 {
     return es_out_Control( p_out, ES_OUT_SET_RATE, i_source_rate, i_rate );
 }
+static inline int es_out_SetTimeRepeat( es_out_t *p_out )
+{
+    return es_out_Control( p_out, ES_OUT_SET_TIME_REPEAT );
+}
 static inline int es_out_SetTime( es_out_t *p_out, vlc_tick_t i_date )
 {
     return es_out_Control( p_out, ES_OUT_SET_TIME, i_date );
diff --git a/src/input/es_out_timeshift.c b/src/input/es_out_timeshift.c
index 877706c659..49eb4742b5 100644
--- a/src/input/es_out_timeshift.c
+++ b/src/input/es_out_timeshift.c
@@ -708,6 +708,16 @@ static int ControlLocked( es_out_t *p_out, int i_query, va_list args )
 
         return ControlLockedSetRate( p_out, i_src_rate, i_rate );
     }
+    case ES_OUT_SET_TIME_REPEAT:
+    {
+        es_out_sys_t *p_sys = p_out->p_sys;
+
+        if( !p_sys->b_delayed )
+            return es_out_SetTimeRepeat( p_sys->p_out );
+
+        msg_Err( p_sys->p_input, "EsOutTimeshift does not yet support repeat" );
+        return VLC_EGENERIC;
+    }
     case ES_OUT_SET_TIME:
     {
         const vlc_tick_t i_date = (vlc_tick_t)va_arg( args, vlc_tick_t );
diff --git a/src/input/input.c b/src/input/input.c
index 7d5b2941a4..bfc2e2f7bc 100644
--- a/src/input/input.c
+++ b/src/input/input.c
@@ -654,6 +654,7 @@ static int MainLoopTryRepeat( input_thread_t *p_input )
         var_SetInteger( p_input, "input-repeat", i_repeat );
     }
     priv->i_repeat_pending++;
+    priv->b_repeat_seek = true;
 
     /* Seek to start title/seekpoint */
     val.i_int = input_priv(p_input)->master->i_title_start -
@@ -2062,7 +2063,11 @@ static bool Control( input_thread_t *p_input,
             else if( f_pos > 1.f )
                 f_pos = 1.f;
             /* Reset the decoders states and clock sync (before calling the demuxer */
-            es_out_SetTime( input_priv(p_input)->p_es_out, -1 );
+            if( input_priv(p_input)->b_repeat_seek )
+                es_out_SetTimeRepeat( input_priv(p_input)->p_es_out );
+            else
+                es_out_SetTime( input_priv(p_input)->p_es_out, -1 );
+            input_priv(p_input)->b_repeat_seek = false;
             if( demux_Control( input_priv(p_input)->master->p_demux, DEMUX_SET_POSITION,
                                (double) f_pos, !input_priv(p_input)->b_fast_seek ) )
             {
@@ -2096,7 +2101,11 @@ static bool Control( input_thread_t *p_input,
                 i_time = 0;
 
             /* Reset the decoders states and clock sync (before calling the demuxer */
-            es_out_SetTime( input_priv(p_input)->p_es_out, -1 );
+            if( input_priv(p_input)->b_repeat_seek )
+                es_out_SetTimeRepeat( input_priv(p_input)->p_es_out );
+            else
+                es_out_SetTime( input_priv(p_input)->p_es_out, -1 );
+            input_priv(p_input)->b_repeat_seek = false;
 
             i_ret = demux_Control( input_priv(p_input)->master->p_demux,
                                    DEMUX_SET_TIME, i_time,
diff --git a/src/input/input_internal.h b/src/input/input_internal.h
index 7496552c82..977c26fd49 100644
--- a/src/input/input_internal.h
+++ b/src/input/input_internal.h
@@ -105,6 +105,8 @@ typedef struct input_thread_private_t
     int64_t     i_stop;     /* :stop-time, 0 if none */
     int64_t     i_time;     /* Current time */
     bool        b_fast_seek;/* :input-fast-seek */
+    bool        b_repeat_seek; /* the queued seek is a repeat of the item,
+                                  not a move elsewhere in it */
     unsigned    i_repeat_pending; /* repeats asked for that have not demuxed
                                      anything yet */
 
-- 
