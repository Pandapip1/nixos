From 83c7c0b4c946638417851a9c72b76c14cecda75f Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Sun, 13 Sep 2026 20:30:44 -0400
Subject: [PATCH 18/41] demux: adaptive: let a repositioned demuxer read again

resetForNewPosition() has two paths. The one that rebuilds the demuxer
tells the ES output it is no longer at the end; the one that merely
repositions only aborts the queued commands. Abort() clears the queue's
own end of file flag, but the demuxer keeps one too, lowered only when a
demuxer is created - and Demuxer::demux() returns Eof while it is raised.

SlaveDemuxer never restarts on seek, so it always takes the second path.
DASH uses it for webvtt and ttml, and it also raises the flag when a single
DEMUX_SET_NEXT_DEMUX_TIME fails. Either way the track is finished for the
session: seeking moves everything else and the subtitles never return.

Give the demuxer a way to forget it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/adaptive/Streams.cpp          | 11 ++++++++++-
 modules/demux/adaptive/plumbing/Demuxer.cpp |  9 +++++++++
 modules/demux/adaptive/plumbing/Demuxer.hpp |  4 ++++
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/modules/demux/adaptive/Streams.cpp b/modules/demux/adaptive/Streams.cpp
index 72b75d1431..d476d77f2b 100644
--- a/modules/demux/adaptive/Streams.cpp
+++ b/modules/demux/adaptive/Streams.cpp
@@ -180,7 +180,16 @@ bool AbstractStream::resetForNewPosition(vlc_tick_t seekMediaTime)
             fakeEsOut()->commandsQueue()->setEOF(false);
         }
     }
-    else fakeEsOut()->commandsQueue()->Abort( true );
+    else
+    {
+        /* Not rebuilt, only repositioned: the demuxer's own end of file flag
+         * is otherwise cleared solely when one is created, and demux() answers
+         * Eof for good while it is set. The slave demuxers used for DASH
+         * subtitle tracks never restart on seek, so without this such a track
+         * stops for the rest of the session once it has run out once. */
+        demuxer->resetEOF();
+        fakeEsOut()->commandsQueue()->Abort( true );
+    }
     return true;
 }
 
diff --git a/modules/demux/adaptive/plumbing/Demuxer.cpp b/modules/demux/adaptive/plumbing/Demuxer.cpp
index e56a55db36..6ea657c097 100644
--- a/modules/demux/adaptive/plumbing/Demuxer.cpp
+++ b/modules/demux/adaptive/plumbing/Demuxer.cpp
@@ -76,6 +76,10 @@ bool AbstractDemuxer::needsRestartOnSeek() const
     return b_reinitsonseek;
 }
 
+void AbstractDemuxer::resetEOF()
+{
+}
+
 AbstractDemuxer::Status AbstractDemuxer::returnCode(int i_ret)
 {
     switch(i_ret)
@@ -139,6 +143,11 @@ bool Demuxer::create()
     return true;
 }
 
+void Demuxer::resetEOF()
+{
+    b_eof = false;
+}
+
 void Demuxer::destroy()
 {
     if(p_demux)
diff --git a/modules/demux/adaptive/plumbing/Demuxer.hpp b/modules/demux/adaptive/plumbing/Demuxer.hpp
index b22a21855f..34aa51f4c6 100644
--- a/modules/demux/adaptive/plumbing/Demuxer.hpp
+++ b/modules/demux/adaptive/plumbing/Demuxer.hpp
@@ -50,6 +50,9 @@ namespace adaptive
             bool needsRestartOnEachSegment() const;
             void setBitstreamSwitchCompatible(bool);
             void setRestartsOnEachSegment(bool);
+            /* Forget having reached the end, for a demuxer that is being
+             * repositioned rather than rebuilt. */
+            virtual void resetEOF();
 
         protected:
             static Status returnCode(int);
@@ -68,6 +71,7 @@ namespace adaptive
             virtual void drain() override;
             virtual bool create() override;
             virtual void destroy() override;
+            virtual void resetEOF() override;
 
         protected:
             AbstractSourceStream *sourcestream;
