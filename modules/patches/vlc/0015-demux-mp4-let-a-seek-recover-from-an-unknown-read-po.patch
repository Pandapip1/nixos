From 873cd4df54128ff8a32f1671ffa678c650c60b80 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Sun, 13 Sep 2026 20:04:50 -0400
Subject: [PATCH 15/50] demux: mp4: let a seek recover from an unknown read
 position

b_error is raised when a seek fails and the seek back to where we were
fails too, leaving the read position unknown. DemuxFrag() then reports end
of stream for good, since nothing lowers it again.

A seek establishes a position of its own: if it succeeds we know where we
are, and if it fails but the restore works we are back where we started.
Only a failed restore leaves the question open, and that path raises the
flag again. Lower it when a seek is attempted, so dragging the seek bar
recovers a stream that would otherwise stay dead until reopened.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/mp4/mp4.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/modules/demux/mp4/mp4.c b/modules/demux/mp4/mp4.c
index e5db797c8b..357541ce55 100644
--- a/modules/demux/mp4/mp4.c
+++ b/modules/demux/mp4/mp4.c
@@ -1610,6 +1610,11 @@ static int Seek( demux_t *p_demux, vlc_tick_t i_date, bool b_accurate )
     demux_sys_t *p_sys = p_demux->p_sys;
     unsigned int i_track;
 
+    /* A seek re-establishes where we are reading from, so whatever left the
+     * position unknown no longer holds. If this attempt fails and the restore
+     * below fails with it, the flag is raised again. */
+    p_sys->b_error = false;
+
     /* Now for each stream try to go to this time */
     vlc_tick_t i_start = i_date;
     for( i_track = 0; i_track < p_sys->i_tracks; i_track++ )
@@ -1801,6 +1806,9 @@ static void FragTrunSeekToTime( mp4_track_t *p_track, stime_t i_target_time )
 static int FragSeekToTime( demux_t *p_demux, vlc_tick_t i_nztime, bool b_accurate )
 {
     demux_sys_t *p_sys = p_demux->p_sys;
+
+    /* As in Seek() above. */
+    p_sys->b_error = false;
     uint64_t i64 = UINT64_MAX;
     uint32_t i_segment_type = ATOM_moof;
     stime_t  i_segment_time = INT64_MAX;
