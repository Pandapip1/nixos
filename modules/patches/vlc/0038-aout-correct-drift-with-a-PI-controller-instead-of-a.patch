@@ -30,6 +30,7 @@
 
 #include <string.h>
 #include <assert.h>
+#include <math.h>
 
 #include <vlc_common.h>
 #include <vlc_dialog.h>
@@ -651,9 +652,7 @@ aout_filters_t *aout_FiltersNew (vlc_object_t *obj,
     }
     if (filters->resampler != NULL)
     {
-        /* Bound the drift correction the caller may accumulate. Kept even so
-         * that the accumulator can still reach exactly 0 in steps of the
-         * caller's adjustment and stop the resampling. */
+        /* Bound the drift correction the caller may ask for. */
         int64_t permille = var_InheritInteger (obj, "aout-max-resampling");
 
         if (permille < 0)
@@ -662,7 +661,7 @@ aout_filters_t *aout_FiltersNew (vlc_object_t *obj,
             permille = 100;
 
         filters->max_resampling =
-            (int)((input_format.i_rate * (uint64_t)permille) / 1000) & ~1;
+            (int)((input_format.i_rate * (uint64_t)permille) / 1000);
     }
     if (filters->rate_filter == NULL)
         filters->rate_filter = filters->resampler;
@@ -696,37 +695,42 @@ void aout_FiltersDelete (vlc_object_t *obj, aout_filters_t *filters)
     free (filters);
 }
 
-bool aout_FiltersCanResample (aout_filters_t *filters)
+/**
+ * Returns the largest drift correction the resampler will apply, as a fraction
+ * of the nominal sample rate. A zeroed bound disables drift correction by
+ * resampling entirely; the resampler itself may still be needed for plain rate
+ * conversion.
+ */
+float aout_FiltersGetMaxResampling (aout_filters_t *filters)
 {
-    /* A zeroed bound disables drift correction by resampling entirely; the
-     * resampler itself may still be needed for plain rate conversion. */
-    return filters->resampler != NULL && filters->max_resampling > 0;
+    if (filters->resampler == NULL)
+        return 0.f;
+
+    return filters->max_resampling
+           / (float)filters->resampler->fmt_in.audio.i_rate;
 }
 
-bool aout_FiltersAdjustResampling (aout_filters_t *filters, int adjust)
+/**
+ * Sets the drift correction applied by the resampler, as a fraction of the
+ * nominal sample rate. Out of bound values are clamped: without that this
+ * ramps into the kHz range, as the rate at which the drift is made up is
+ * proportional to the offset, and the offset is applied to the resampler
+ * input rate.
+ */
+void aout_FiltersSetResampling (aout_filters_t *filters, float ratio)
 {
     if (filters->resampler == NULL)
-        return false;
+        return;
 
-    if (adjust)
-    {
-        /* Without a bound this ramps into the kHz range: the rate the drift is
-         * made up at is proportional to the offset, and the offset is applied
-         * to the resampler input rate. Kept even so the accumulator can still
-         * reach exactly zero in steps of `adjust`. */
-        const int max = filters->max_resampling;
-        int resampling = filters->resampling + adjust;
-
-        if (resampling > max)
-            resampling = max;
-        else if (resampling < -max)
-            resampling = -max;
-
-        filters->resampling = resampling;
-    }
-    else
-        filters->resampling = 0;
-    return filters->resampling != 0;
+    const int max = filters->max_resampling;
+    int resampling = lroundf (ratio * filters->resampler->fmt_in.audio.i_rate);
+
+    if (resampling > max)
+        resampling = max;
+    else if (resampling < -max)
+        resampling = -max;
+
+    filters->resampling = resampling;
 }
 
 block_t *aout_FiltersPlay (aout_filters_t *filters, block_t *block, int rate)
