From 5f08d684e3308b188716b9f7b4119ccadfdfd404 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Tue, 15 Sep 2026 20:05:32 -0400
Subject: [PATCH 39/64] scaletempo: do not fade the audio in on the first
 stride

The overlap buffer holds the tail of the previous stride, to be blended
into the start of the next one. Before anything has gone out it holds the
zeros it was allocated with, and blending against those ramps the audio up
from silence over the length of the overlap - six milliseconds of fade,
heard at the start of every stretch and after every flush.

Copy the first stride across instead, and blend from the one after.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/audio_filter/scaletempo.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/modules/audio_filter/scaletempo.c b/modules/audio_filter/scaletempo.c
index d881b2e5ad..6bd768f877 100644
--- a/modules/audio_filter/scaletempo.c
+++ b/modules/audio_filter/scaletempo.c
@@ -122,6 +122,7 @@ struct filter_sys_t
     unsigned  samples_standing;
     unsigned  bytes_overlap;
     unsigned  bytes_standing;
+    bool      overlap_primed; /* buf_overlap holds a tail to blend with */
     void     *buf_overlap;
     void     *table_blend;
     void    (*output_overlap)( filter_t *p_filter, void *p_out_buf, unsigned bytes_off );
@@ -255,7 +256,15 @@ static size_t transform_buffer( filter_t        *p_filter,
             if( p->best_overlap_offset ) {
                 bytes_off = p->best_overlap_offset( p_filter );
             }
-            p->output_overlap( p_filter, pout, bytes_off );
+            if( p->overlap_primed )
+                p->output_overlap( p_filter, pout, bytes_off );
+            else {
+                /* Nothing has gone out yet, so there is no tail to blend
+                 * with. Blending against the empty buffer would fade the
+                 * audio in over the length of the overlap. */
+                memcpy( pout, p->buf_queue + bytes_off, p->bytes_overlap );
+                p->overlap_primed = true;
+            }
         }
         memcpy( pout + p->bytes_overlap,
                 p->buf_queue + bytes_off + p->bytes_overlap,
@@ -441,6 +450,7 @@ static int Open( vlc_object_t *p_this )
     p_sys->buf_pre_corr   = NULL;
     p_sys->table_window   = NULL;
     p_sys->bytes_overlap  = 0;
+    p_sys->overlap_primed = false;
     p_sys->bytes_queued   = 0;
     p_sys->bytes_to_slide = 0;
     p_sys->frames_stride_error = 0;
