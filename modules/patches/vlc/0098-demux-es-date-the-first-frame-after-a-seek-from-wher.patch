From 51a3a8715be5df2493109fa67bf51f5eaaff4c48 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Wed, 16 Sep 2026 16:29:06 -0400
Subject: [PATCH 098/104] demux: es: date the first frame after a seek from
 where the seek landed

The mpeg audio elementary stream demuxer never tells its packetizer that the
stream has moved. A seek leaves the packetizer holding the beginning of the
frame that was next before it, and holding the date it had reached, and the
demuxer then pins that date to the position sought to with
i_time_offset = i_time - i_pts. But i_pts is the start of the last frame handed
over, and the packetizer will date the next frame a whole frame further on, so
everything after a seek comes out one frame duration late and the frame that
belongs at the position sought to is never handed over at all.

An item repeating in place is seeked back to its start, so this costs it a frame
on every pass but the first. tone.mp3 through the mpga demuxer resumed 72000 us
in, which is exactly one 1152 sample frame at 16 kHz, and each loop lost as much
again.

Empty the packetizer on a seek and give it the start of a stream again - b_start
is what makes the next block carry a date - so the offset it is pinned to is the
position sought to, with nothing left over from before the seek to be glued onto
the first frame after it.

test_src_input_demux_repeat's mpga row went from "the repeated pass begins at
72001 us where the first began at 1 us" to "1 us .. 1224001 us, twice over". A
file of eight tones still hands over all 129 of its frames in a plain pass, and
a seek half way into it now lands on the frame at the position asked for rather
than on the one after it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/mpeg/es.c | 51 +++++++++++++++++++++++++++++++----------
 1 file changed, 39 insertions(+), 12 deletions(-)

diff --git a/modules/demux/mpeg/es.c b/modules/demux/mpeg/es.c
index bb98bf37cd..9b29a2abba 100644
--- a/modules/demux/mpeg/es.c
+++ b/modules/demux/mpeg/es.c
@@ -386,6 +386,41 @@ static void Close( vlc_object_t * p_this )
     free( p_sys );
 }
 
+/*****************************************************************************
+ * PostSeekReset: put the parser back where the stream now is
+ *****************************************************************************
+ * A seek leaves the packetizer holding the bytes of a frame that is no longer
+ * the one that comes next, and a date that no longer says anything about
+ * where the stream has landed. Empty it and give it the start of a stream
+ * again, so that the first frame after the seek is dated from the position
+ * sought to instead of being carried on from the frame before the seek.
+ *****************************************************************************/
+static void PostSeekReset( demux_t *p_demux, vlc_tick_t i_time )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+
+    if( p_sys->p_packetizer->pf_flush )
+        p_sys->p_packetizer->pf_flush( p_sys->p_packetizer );
+    else
+    {
+        block_t *p_block_out;
+        while( ( p_block_out = p_sys->p_packetizer->pf_packetize(
+                                   p_sys->p_packetizer, NULL ) ) )
+            block_ChainRelease( p_block_out );
+    }
+
+    /* And reset buffered data */
+    if( p_sys->p_packetized_data )
+        block_ChainRelease( p_sys->p_packetized_data );
+    p_sys->p_packetized_data = NULL;
+
+    /* An emptied packetizer dates itself from the block it is next handed,
+     * and b_start is what makes that block carry a date. */
+    p_sys->b_start = true;
+    p_sys->i_pts = 0;
+    p_sys->i_time_offset = i_time;
+}
+
 /*****************************************************************************
  * Control:
  *****************************************************************************/
@@ -453,11 +488,7 @@ static int Control( demux_t *p_demux, int i_query, va_list args )
                 int i_ret = vlc_stream_Seek( p_demux->s, p_sys->i_stream_offset + i_pos );
                 if( i_ret != VLC_SUCCESS )
                     return i_ret;
-                p_sys->i_time_offset = i_time - p_sys->i_pts;
-                /* And reset buffered data */
-                if( p_sys->p_packetized_data )
-                    block_ChainRelease( p_sys->p_packetized_data );
-                p_sys->p_packetized_data = NULL;
+                PostSeekReset( p_demux, i_time );
                 return VLC_SUCCESS;
             }
             /* FIXME TODO: implement a high precision seek (with mp3 parsing)
@@ -473,13 +504,9 @@ static int Control( demux_t *p_demux, int i_query, va_list args )
                 int64_t i_time = INT64_C(8000000) * ( vlc_stream_Tell(p_demux->s) - p_sys->i_stream_offset ) /
                     p_sys->i_bitrate_avg;
 
-                /* Fix time_offset */
-                if( i_time >= 0 )
-                    p_sys->i_time_offset = i_time - p_sys->i_pts;
-                /* And reset buffered data */
-                if( p_sys->p_packetized_data )
-                    block_ChainRelease( p_sys->p_packetized_data );
-                p_sys->p_packetized_data = NULL;
+                if( i_time < 0 )
+                    i_time = 0;
+                PostSeekReset( p_demux, i_time );
             }
             return i_ret;
     }
