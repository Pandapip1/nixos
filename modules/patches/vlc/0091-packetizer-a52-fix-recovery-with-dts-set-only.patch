From 83b944af7ea3add6b25a09df5bf93c721b8e0db1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Fran=C3=A7ois=20Cartegnie?= <fcvlcdev@free.fr>
Date: Wed, 20 Dec 2023 16:05:07 +0100
Subject: [PATCH 091/100] packetizer: a52: fix recovery with dts set only

(cherry picked from commit d3d6132ea5b0fd1e81e7fa0afa56d3947d6119ea)
---
 modules/packetizer/a52.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/modules/packetizer/a52.c b/modules/packetizer/a52.c
index 2ac90fb65f..a637ec9a77 100644
--- a/modules/packetizer/a52.c
+++ b/modules/packetizer/a52.c
@@ -104,8 +104,12 @@ static block_t *GetOutBuffer( decoder_t *p_dec )
             date_Init( &p_sys->end_date, p_sys->frame.i_rate, 1 );
     }
 
-    if( p_sys->bytestream.p_block->i_pts != date_Get( &p_sys->end_date ) &&
-        p_sys->bytestream.p_block->i_pts != VLC_TICK_INVALID )
+    block_t *p_bshead = p_sys->bytestream.p_block;
+    /* Ensure we can recover if there's only dts set */
+    if( date_Get( &p_sys->end_date ) == VLC_TICK_INVALID && p_bshead->i_pts == VLC_TICK_INVALID )
+        p_bshead->i_pts = p_bshead->i_dts;
+
+    if( p_bshead->i_pts != VLC_TICK_INVALID && p_bshead->i_pts != date_Get( &p_sys->end_date ) )
     {
         /* Make sure we don't reuse the same pts twice
          * as A/52 in PES sends multiple times the same pts */
