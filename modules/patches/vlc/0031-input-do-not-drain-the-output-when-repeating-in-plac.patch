From 96374f73146c23f9363cc97e90214ec80f62004b Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 14 Sep 2026 23:02:27 -0400
Subject: [PATCH 31/44] input: do not drain the output when repeating in place

Draining is for an end that is one. A repeat carries straight on, and a
drain plays the output empty and then stops it, so the next pass has to
start it again - heard as a gap at every loop.

The main loop still waits for the decoders to report empty, and that now
means their output has been played, so the repeat is still paced by the
sound finishing without emptying the output to find out. If the repeat
turns out not to happen, the end was real and the drain happens then.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/input/input.c | 33 ++++++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/input/input.c b/src/input/input.c
index ab37a7c7e8..de021e17e3 100644
--- a/src/input/input.c
+++ b/src/input/input.c
@@ -557,6 +557,8 @@ bool input_Stopped( input_thread_t *input )
  * MainLoopDemux
  * It asks the demuxer to demux some data
  */
+static bool MainLoopRepeatsInPlace( input_thread_t * );
+
 static void MainLoopDemux( input_thread_t *p_input, bool *pb_changed )
 {
     input_thread_private_t* p_priv = input_priv(p_input);
@@ -600,7 +602,14 @@ static void MainLoopDemux( input_thread_t *p_input, bool *pb_changed )
     {
         msg_Dbg( p_input, "EOF reached" );
         p_priv->master->b_eof = true;
-        es_out_Eos(p_priv->p_es_out);
+
+        /* Draining is for an end that is one. Repeating in place carries on
+         * from here, and a drain empties the output and stops it, so the next
+         * pass has to start it again - heard as a gap at every loop. The
+         * decoders still report empty once what they produced has been
+         * played, which is what the main loop waits for. */
+        if( !MainLoopRepeatsInPlace( p_input ) )
+            es_out_Eos(p_priv->p_es_out);
     }
     else if( i_ret == VLC_DEMUXER_EGENERIC )
     {
@@ -616,6 +625,23 @@ static void MainLoopDemux( input_thread_t *p_input, bool *pb_changed )
 #define INPUT_REPEAT_MAX_PENDING 5
 
 
+/**
+ * Whether reaching the end will repeat the item where it stands rather than
+ * finish it. The test MainLoopTryRepeat() applies, less the pending count,
+ * which only says whether a repeat already asked for has been applied yet.
+ */
+static bool MainLoopRepeatsInPlace( input_thread_t *p_input )
+{
+    int i_repeat = var_GetInteger( p_input, "input-repeat" );
+
+    if( i_repeat < 0 )
+        return false;
+    if( i_repeat == 0 )
+        return var_GetBool( p_input, "can-seek" )
+            && var_InheritBool( p_input, "repeat" );
+    return true;
+}
+
 static int MainLoopTryRepeat( input_thread_t *p_input )
 {
     input_thread_private_t *priv = input_priv(p_input);
@@ -799,7 +825,12 @@ static void MainLoop( input_thread_t *p_input, bool b_interactive )
             else
             {
                 if( MainLoopTryRepeat( p_input ) )
+                {
+                    /* Not repeating after all, so it was an end: drain what
+                     * was left undrained above. */
+                    es_out_Eos( input_priv(p_input)->p_es_out );
                     break;
+                }
             }
 
             /* Update interface and statistics */
