From 595e45d6adbac0c7c44f9035ec3c9b9aea09d7de Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Wed, 16 Sep 2026 03:58:00 -0400
Subject: [PATCH 65/76] input: count a repeat as progress only when data comes
 out

The count that stops a repeat spinning is cleared whenever Demux() returns
success, but success only says the demuxer wants to be called again - it
does not say anything reached the output. A demuxer that answers that way
having emitted nothing clears the count at every pass, so the count never
reaches its limit and the input repeats as fast as the loop can turn.

A subtitle file played as the item itself does it: the program stream
demuxer claims a .srt, finds nothing it recognises, and says success. With
--repeat that is 813969 repeats in fifteen seconds, a core spent on nothing.

es_out already knows, since it was taught to track how far the data handed
over reaches in order to place the next pass: no data since the last change
of position means the demuxer has produced nothing to carry on from. Ask it,
and let the count stand when the answer is no. The same run gives up after
the five tries it is allowed, as it was meant to.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/input/es_out.c           | 16 ++++++++++++++++
 src/input/es_out.h           | 13 +++++++++++++
 src/input/es_out_timeshift.c | 18 ++++++++++++++++++
 src/input/input.c            |  6 +++++-
 4 files changed, 52 insertions(+), 1 deletion(-)

diff --git a/src/input/es_out.c b/src/input/es_out.c
index deeb8aff01..646387490d 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -2950,6 +2950,22 @@ static int EsOutControlLocked( es_out_t *out, int i_query, va_list args )
         return VLC_SUCCESS;
     }
 
+    case ES_OUT_GET_PROGRESSED:
+    {
+        bool *pb = va_arg( args, bool* );
+
+        *pb = false;
+        for( int i = 0; i < p_sys->i_pgrm; i++ )
+        {
+            if( p_sys->pgrm[i]->i_last_end > VLC_TICK_INVALID )
+            {
+                *pb = true;
+                break;
+            }
+        }
+        return VLC_SUCCESS;
+    }
+
     case ES_OUT_SET_DELAY:
     {
         const int i_cat = va_arg( args, int );
diff --git a/src/input/es_out.h b/src/input/es_out.h
index c68371ad01..ace43884e9 100644
--- a/src/input/es_out.h
+++ b/src/input/es_out.h
@@ -94,6 +94,11 @@ enum es_out_query_private_e
      * outputs still have up to i_lead left to play: the caller is given that
      * much time to have the next thing ready. */
     ES_OUT_GET_ENDING,      /* arg1=vlc_tick_t i_lead arg2=bool* res=cannot fail */
+
+    /* Whether the demuxer has handed any data over since the last position
+     * change: a demuxer can return success from Demux() without emitting
+     * anything, and a repeat that keeps doing so is not making progress. */
+    ES_OUT_GET_PROGRESSED,  /* arg1=bool* res=cannot fail */
 };
 
 static inline void es_out_SetMode( es_out_t *p_out, int i_mode )
@@ -133,6 +138,14 @@ static inline bool es_out_GetEnding( es_out_t *p_out, vlc_tick_t i_lead )
     assert( !i_ret );
     return b;
 }
+static inline bool es_out_GetProgressed( es_out_t *p_out )
+{
+    bool b;
+    int i_ret = es_out_Control( p_out, ES_OUT_GET_PROGRESSED, &b );
+
+    assert( !i_ret );
+    return b;
+}
 static inline void es_out_SetDelay( es_out_t *p_out, int i_cat, vlc_tick_t i_delay )
 {
     int i_ret = es_out_Control( p_out, ES_OUT_SET_DELAY, i_cat, i_delay );
diff --git a/src/input/es_out_timeshift.c b/src/input/es_out_timeshift.c
index a88f250e0f..12b24a725b 100644
--- a/src/input/es_out_timeshift.c
+++ b/src/input/es_out_timeshift.c
@@ -507,6 +507,19 @@ static int ControlLockedGetEnding( es_out_t *p_out, vlc_tick_t i_lead,
 
     return VLC_SUCCESS;
 }
+static int ControlLockedGetProgressed( es_out_t *p_out, bool *pb )
+{
+    es_out_sys_t *p_sys = p_out->p_sys;
+
+    /* A queued command is data the demuxer handed over, whether or not it has
+     * reached the output yet. */
+    if( p_sys->b_delayed && TsHasCmd( p_sys->p_ts ) )
+        *pb = true;
+    else
+        *pb = es_out_GetProgressed( p_sys->p_out );
+
+    return VLC_SUCCESS;
+}
 static int ControlLockedGetEmpty( es_out_t *p_out, bool *pb_empty )
 {
     es_out_sys_t *p_sys = p_out->p_sys;
@@ -701,6 +714,11 @@ static int ControlLocked( es_out_t *p_out, int i_query, va_list args )
         bool *pb_empty = (bool*)va_arg( args, bool* );
         return ControlLockedGetEnding( p_out, i_lead, pb_empty );
     }
+    case ES_OUT_GET_PROGRESSED:
+    {
+        bool *pb = (bool*)va_arg( args, bool* );
+        return ControlLockedGetProgressed( p_out, pb );
+    }
     case ES_OUT_GET_WAKE_UP: /* TODO ? */
     {
         vlc_tick_t *pi_wakeup = (vlc_tick_t*)va_arg( args, vlc_tick_t* );
diff --git a/src/input/input.c b/src/input/input.c
index 0af3384639..1621c498cc 100644
--- a/src/input/input.c
+++ b/src/input/input.c
@@ -579,7 +579,11 @@ static void MainLoopDemux( input_thread_t *p_input, bool *pb_changed )
     if( i_ret == VLC_DEMUXER_SUCCESS )
         i_ret = demux_Demux( p_demux );
 
-    if( i_ret > 0 )
+    /* Only data reaching the output says the repeat got somewhere. A demuxer
+     * can return success having emitted nothing at all - a subtitle file
+     * claimed by a program stream demuxer does it at every pass - and taking
+     * the return alone would clear the count forever and spin. */
+    if( i_ret > 0 && es_out_GetProgressed( p_priv->p_es_out ) )
         p_priv->i_repeat_pending = 0;
 
     i_ret = i_ret > 0 ? VLC_DEMUXER_SUCCESS : ( i_ret < 0 ? VLC_DEMUXER_EGENERIC : VLC_DEMUXER_EOF);
