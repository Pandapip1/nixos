From 7f4ffdc4344a7d49159483c22d30c086401d676f Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Sun, 13 Sep 2026 19:51:19 -0400
Subject: [PATCH 13/76] demux: ty: keep the record count in step with the
 record headers

get_chunk_header() commits the record count to p_sys straight after reading
it, then frees the header array and rebuilds it - and can leave between the
two: a count at or above MAX_NUM_RECS, a short read, a failed allocation or
a truncated header block. The count then describes an array that is gone,
or the previous smaller one.

Demux() checks the return value, but ty_stream_seek_pct() and
ty_stream_seek_time() call get_chunk_header() for its side effects and
index rec_hdrs unconditionally: on a malformed file that is a NULL
dereference or a read past the previous allocation.

Commit the count only once the array it describes exists.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/ty.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/modules/demux/ty.c b/modules/demux/ty.c
index 8a9e7ed349..db8777b6e1 100644
--- a/modules/demux/ty.c
+++ b/modules/demux/ty.c
@@ -1956,7 +1956,7 @@ static int get_chunk_header(demux_t *p_demux)
     if (p_peek[3] & 0x80)
     {
         /* 16 bit rec cnt */
-        p_sys->i_num_recs = i_num_recs = (p_peek[1] << 8) + p_peek[0];
+        i_num_recs = (p_peek[1] << 8) + p_peek[0];
         p_sys->i_seq_rec = (p_peek[3] << 8) + p_peek[2];
         if (p_sys->i_seq_rec != 0xffff)
         {
@@ -1966,7 +1966,7 @@ static int get_chunk_header(demux_t *p_demux)
     else
     {
         /* 8 bit reclen - tivo 1.3 format */
-        p_sys->i_num_recs = i_num_recs = p_peek[0];
+        i_num_recs = p_peek[0];
         p_sys->i_seq_rec = p_peek[1];
     }
 
@@ -1980,6 +1980,10 @@ static int get_chunk_header(demux_t *p_demux)
 
     free(p_sys->rec_hdrs);
     p_sys->rec_hdrs = NULL;
+    /* Keep the count in step with the array. Every bail-out below leaves the
+     * array gone, and the seek helpers index it without checking whether this
+     * function succeeded. */
+    p_sys->i_num_recs = 0;
 
     /* skip past the 4 bytes we "peeked" earlier */
     if(vlc_stream_Read(p_demux->s, NULL, 4) != 4)
@@ -2003,6 +2007,8 @@ static int get_chunk_header(demux_t *p_demux)
         return VLC_ENOMEM;
     }
 
+    p_sys->i_num_recs = i_num_recs;
+
     p_sys->i_stuff_cnt = CHUNK_SIZE - 4 -
         (p_sys->i_num_recs * REC_SIZE) - i_payload_size;
     if (p_sys->i_stuff_cnt > 0)
