From 8e1e2b3ecdb8a534d7aae46b11aa58158f7ba03b Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Tue, 15 Sep 2026 22:29:35 -0400
Subject: [PATCH 048/104] demux: rawaud: fix wrong pts after a seek

Control() is a bare demux_vaControlHelper() call, and the helper implements
DEMUX_SET_POSITION and DEMUX_SET_TIME as a plain vlc_stream_Seek(): the
stream moves, but the pts accumulator is left untouched and keeps counting
from where it was before the seek.

DEMUX_GET_TIME goes through the same helper and is derived from the byte
offset, so it stays correct, and the timestamps the demuxer emits no longer
agree with the time it reports. Playback of the track itself survives
because the input resets the PCR on every seek, but slave ES do not:
SlaveDemux() paces external subtitles from the master DEMUX_GET_TIME, so
after a seek they are shifted by the accumulated error, or dropped for
being too late or too early.

Resync the date with the new offset, using the same byte to time conversion
as the helper. The stream is headerless, so the offset is the time origin.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/rawaud.c | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/modules/demux/rawaud.c b/modules/demux/rawaud.c
index 3ac90008a5..33779ce870 100644
--- a/modules/demux/rawaud.c
+++ b/modules/demux/rawaud.c
@@ -274,6 +274,25 @@ static int Control( demux_t *p_demux, int i_query, va_list args )
 {
     demux_sys_t *p_sys  = p_demux->p_sys;
 
-    return demux_vaControlHelper( p_demux->s, 0, -1,
+    int i_ret = demux_vaControlHelper( p_demux->s, 0, -1,
                                   p_sys->fmt.i_bitrate, p_sys->i_seek_step, i_query, args );
+    if( i_ret != VLC_SUCCESS )
+        return i_ret;
+
+    switch( i_query )
+    {
+        case DEMUX_SET_POSITION:
+        case DEMUX_SET_TIME:
+            /* The helper only moved the stream: resync the pts accumulator,
+             * else it would keep counting from before the seek and drift
+             * away from the byte derived DEMUX_GET_TIME.
+             * Same byte to time conversion as demux_vaControlHelper(). */
+            date_Set( &p_sys->pts, INT64_C(8000000)
+                      * vlc_stream_Tell( p_demux->s ) / p_sys->fmt.i_bitrate );
+            break;
+        default:
+            break;
+    }
+
+    return VLC_SUCCESS;
 }
