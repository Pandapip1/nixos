From 75808e7c5f010031e92ab58a718504d052e556a8 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 14 Sep 2026 23:02:17 -0400
Subject: [PATCH 30/85] input: a decoder is empty once its output has been
 played

input_DecoderIsEmpty() said empty for audio as soon as the decoder's fifo
was, which says only that the decoder has nothing left to hand over, not
that any of it has been heard. Anything pacing on that is early by
whatever the output is still holding.

That is why the end-of-stream wait has to drain first: the drain is what
makes the answer mean what the caller needs. aout_DecIsEmpty() gives the
real answer, from the end of the last buffer queued.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/audio_output/aout_internal.h |  1 +
 src/audio_output/dec.c           | 17 +++++++++++++++++
 src/input/decoder.c              | 11 ++++++++++-
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/audio_output/aout_internal.h b/src/audio_output/aout_internal.h
index ee40a338a8..e4265335fe 100644
--- a/src/audio_output/aout_internal.h
+++ b/src/audio_output/aout_internal.h
@@ -157,6 +157,7 @@ int aout_DecPlay(audio_output_t *, block_t *, int i_input_rate);
 void aout_DecGetResetStats(audio_output_t *, unsigned *, unsigned *);
 void aout_DecChangePause(audio_output_t *, bool b_paused, vlc_tick_t i_date);
 void aout_DecFlush(audio_output_t *, bool wait);
+bool aout_DecIsEmpty(audio_output_t *);
 void aout_RequestRestart (audio_output_t *, unsigned);
 
 static inline void aout_InputRequestRestart(audio_output_t *aout)
diff --git a/src/audio_output/dec.c b/src/audio_output/dec.c
index b791f81be9..2422123c88 100644
--- a/src/audio_output/dec.c
+++ b/src/audio_output/dec.c
@@ -421,6 +421,23 @@ lost:
     goto out;
 }
 
+/**
+ * Whether everything handed to the output has been played.
+ *
+ * For pacing on the end of playback without draining. A drain also stops the
+ * output, which is the wrong thing to do when more is about to follow it.
+ */
+bool aout_DecIsEmpty (audio_output_t *aout)
+{
+    aout_owner_t *owner = aout_owner (aout);
+    bool empty;
+
+    aout_OutputLock (aout);
+    empty = owner->sync.end == VLC_TICK_INVALID || mdate () >= owner->sync.end;
+    aout_OutputUnlock (aout);
+    return empty;
+}
+
 void aout_DecGetResetStats(audio_output_t *aout, unsigned *restrict lost,
                            unsigned *restrict played)
 {
diff --git a/src/input/decoder.c b/src/input/decoder.c
index 69488a681c..dbf06c0fb6 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -2088,7 +2088,16 @@ bool input_DecoderIsEmpty( decoder_t * p_dec )
     if( p_owner->fmt.i_cat == VIDEO_ES && p_owner->p_vout != NULL )
         b_empty = vout_IsEmpty( p_owner->p_vout );
     else if( p_owner->fmt.i_cat == AUDIO_ES )
-        b_empty = !p_owner->b_draining || p_owner->drained;
+    {
+        if( p_owner->b_draining )
+            b_empty = p_owner->drained;
+        else
+            /* Not draining: the fifo being empty only says the decoder has
+             * nothing left to hand over, not that any of it has been heard.
+             * Whoever is waiting for the end is waiting for the sound. */
+            b_empty = p_owner->p_aout == NULL
+                   || aout_DecIsEmpty( p_owner->p_aout );
+    }
     else
         b_empty = true; /* TODO subtitles support */
     vlc_mutex_unlock( &p_owner->lock );
