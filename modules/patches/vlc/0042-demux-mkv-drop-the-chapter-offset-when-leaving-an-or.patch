From ff410cf817353be51276e917c615180b4aaa2e35 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Tue, 15 Sep 2026 22:20:09 -0400
Subject: [PATCH 42/97] demux: mkv: drop the chapter offset when leaving an
 ordered edition

Only an ordered edition splices its chapters onto a timeline of its own,
so i_mk_chapter_time is assigned under that condition and nowhere else.
Nothing ever clears it. Editions are exposed as titles, so selecting a
non-ordered one after an ordered one leaves the offset from the edition
just left applied to every timestamp of the new one - and to the position
it reports, which is derived from the same figure.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/mkv/virtual_segment.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/modules/demux/mkv/virtual_segment.cpp b/modules/demux/mkv/virtual_segment.cpp
index 336edb91ef..ba073b5e6a 100644
--- a/modules/demux/mkv/virtual_segment.cpp
+++ b/modules/demux/mkv/virtual_segment.cpp
@@ -537,6 +537,11 @@ bool virtual_segment_c::Seek( demux_t & demuxer, vlc_tick_t i_mk_date,
         vlc_tick_t i_mk_time_offset = p_vchapter->i_mk_virtual_start_time - ( ( p_vchapter->p_chapter )? p_vchapter->p_chapter->i_start_time : 0 );
         if (CurrentEdition()->b_ordered)
             p_sys->i_mk_chapter_time = p_vchapter->i_mk_virtual_start_time - p_vchapter->segment.i_mk_start_time - ( ( p_vchapter->p_chapter )? p_vchapter->p_chapter->i_start_time : 0 ) /* + VLC_TICK_0 */;
+        else
+            /* Only an ordered edition splices chapters onto a timeline of its
+             * own. Nothing clears the offset otherwise, so an edition seeked
+             * away from leaves it on every timestamp of the next one. */
+            p_sys->i_mk_chapter_time = 0;
         if ( p_vchapter->p_chapter && p_vchapter->i_seekpoint_num > 0 )
         {
             demuxer.info.i_update |= INPUT_UPDATE_TITLE | INPUT_UPDATE_SEEKPOINT;
