From 02d63ab365167cb43a0b46f83f97dea0629dd55a Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Wed, 16 Sep 2026 04:50:35 -0400
Subject: [PATCH 71/93] demux: ts: forget the continuity counters over a seek
 of its own

A seek lands on a packet that has nothing to do with the one read before it,
so every pid's continuity counter jumps, and the demuxer reports the jump it
was itself asked for as a break in the stream: a warning per pid, a libdvbpsi
section error for each psi pid, and a discontinuity flag on the first block of
every stream pid on top of the one the seek already sets deliberately.

Forget the counters instead, so the first packet after the seek is taken for
what it is, the first one seen on that pid. Nothing downstream loses a warning
it needed: a seek already tells the elementary streams that their data is not
continuous, and it does so once rather than once per pid.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/demux/mpeg/ts.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/modules/demux/mpeg/ts.c b/modules/demux/mpeg/ts.c
index 73b95d0167..f5972af334 100644
--- a/modules/demux/mpeg/ts.c
+++ b/modules/demux/mpeg/ts.c
@@ -1875,6 +1875,21 @@ static void ReadyQueuesPostSeek( demux_t *p_demux )
 {
     demux_sys_t *p_sys = p_demux->p_sys;
 
+    /* The counters carry on from wherever the stream was left, and a seek
+     * lands on a packet that has nothing to do with the one before it. Every
+     * pid would then report the jump it was itself asked for as a break in
+     * the stream, and each break costs the packetizer the frame it is holding
+     * and the decoder its start. Forget them instead, so the first packet
+     * after the seek is taken for what it is: the first one seen on that pid. */
+    ts_pid_next_context_t ctx = ts_pid_NextContextInitValue;
+    for( ts_pid_t *pid = ts_pid_Next( &p_sys->pids, &ctx );
+         pid; pid = ts_pid_Next( &p_sys->pids, &ctx ) )
+    {
+        pid->i_cc = 0xff;
+        pid->i_dup = 0;
+        memset( pid->prevpktbytes, 0, PREVPKTKEEPBYTES );
+    }
+
     ts_pat_t *p_pat = GetPID(p_sys, 0)->u.p_pat;
     for( int i=0; i< p_pat->programs.i_size; i++ )
     {
