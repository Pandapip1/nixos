From 49a65247661550da4e6144e8d07b5881f3af8570 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 14 Sep 2026 23:19:56 -0400
Subject: [PATCH 32/41] input: let a repeat keep what the output is holding

The first PCR of a repeated pass reads late because the demuxer had to seek
to produce it, and es_out answers a late PCR by rebuffering - which throws
away the audio kept to cover the loop, as its own comment concedes. Take
the jitter instead, until a PCR arrives on time again.

And the next pass was asked for only once the output had finished, which is
too late: demuxing it takes time, and the output sits empty for exactly
that long. Ask a little before the end; nothing is skipped, since what
follows is queued behind what is left.

Ten captures of a repeating sweep: no silence in any, against three gaps
per run before.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/audio_output/dec.c | 11 +++++++++--
 src/input/es_out.c     | 16 ++++++++++++++++
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/src/audio_output/dec.c b/src/audio_output/dec.c
index 4a71f0ca48..732596699c 100644
--- a/src/audio_output/dec.c
+++ b/src/audio_output/dec.c
@@ -421,10 +421,16 @@ lost:
 }
 
 /**
- * Whether everything handed to the output has been played.
+ * Whether what was handed to the output has been played, or is about to be.
  *
  * For pacing on the end of playback without draining. A drain also stops the
  * output, which is the wrong thing to do when more is about to follow it.
+ *
+ * Reported a little before the end rather than at it. Whoever is waiting has
+ * something to do before the sound it produces reaches the output - demux,
+ * decode - and waiting for the last sample to be played first means the output
+ * is empty for exactly as long as that takes. The lead costs nothing: what
+ * follows is queued behind what is left, not in place of it.
  */
 bool aout_DecIsEmpty (audio_output_t *aout)
 {
@@ -432,7 +438,8 @@ bool aout_DecIsEmpty (audio_output_t *aout)
     bool empty;
 
     aout_OutputLock (aout);
-    empty = owner->sync.end == VLC_TICK_INVALID || mdate () >= owner->sync.end;
+    empty = owner->sync.end == VLC_TICK_INVALID
+         || mdate () + AOUT_MAX_PTS_ADVANCE >= owner->sync.end;
     aout_OutputUnlock (aout);
     return empty;
 }
diff --git a/src/input/es_out.c b/src/input/es_out.c
index 38da54b796..fc6d8fa216 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -171,6 +171,7 @@ struct es_out_sys_t
 
     /* Used for buffering */
     bool        b_buffering;
+    bool        b_repeated; /* the last reposition was a repeat of the item */
     vlc_tick_t  i_buffering_extra_initial;
     vlc_tick_t  i_buffering_extra_stream;
     vlc_tick_t  i_buffering_extra_system;
@@ -337,6 +338,7 @@ es_out_t *input_EsOutNew( input_thread_t *p_input, int i_rate )
     p_sys->i_rate = i_rate;
 
     p_sys->b_buffering = true;
+    p_sys->b_repeated = false;
     p_sys->i_preroll_end = -1;
     p_sys->i_prev_stream_level = -1;
 
@@ -2569,6 +2571,19 @@ static int EsOutControlLocked( es_out_t *out, int i_query, va_list args )
                     for( int i = 0; i < p_sys->i_pgrm; i++ )
                       input_clock_Reset( p_sys->pgrm[i]->p_clock );
                 }
+                else if( p_sys->b_repeated )
+                {
+                    /* The first PCR of a repeated pass reads late because the
+                     * demuxer had to seek to produce it, not because playback
+                     * is behind. Rebuffering for that throws away the audio
+                     * that was deliberately kept to cover the loop, and stops
+                     * the output, which is heard. Take the jitter and carry
+                     * on. */
+                    msg_Dbg( p_sys->p_input,
+                             "ES_OUT_SET_(GROUP_)PCR is late after a repeat "
+                             "(pts_delay increased to %d ms)",
+                             (int)(i_pts_delay/1000) );
+                }
                 else
                 {
                     msg_Err( p_sys->p_input,
@@ -2841,6 +2856,7 @@ static int EsOutControlLocked( es_out_t *out, int i_query, va_list args )
          * decoded needs discarding, and keeping it is what makes the loop
          * inaudible. */
         EsOutChangePosition( out, false );
+        p_sys->b_repeated = true;
         return VLC_SUCCESS;
 
     case ES_OUT_SET_FRAME_NEXT:
-- 
