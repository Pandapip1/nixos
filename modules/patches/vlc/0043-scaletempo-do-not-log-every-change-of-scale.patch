From 4490ab85a707058cb6a48fd1b05c505669c0639c Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Tue, 15 Sep 2026 20:05:51 -0400
Subject: [PATCH 43/44] scaletempo: do not log every change of scale

Correcting drift varies the scale continuously - a couple of hundred
changes a second of audio - and each one printed a line.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/audio_filter/scaletempo.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/modules/audio_filter/scaletempo.c b/modules/audio_filter/scaletempo.c
index 6bd768f877..dfd8237b01 100644
--- a/modules/audio_filter/scaletempo.c
+++ b/modules/audio_filter/scaletempo.c
@@ -579,10 +579,6 @@ static block_t *DoWork( filter_t * p_filter, block_t * p_in_buf )
       p->bytes_stride_scaled  = p->bytes_stride * p->scale;
       p->frames_stride_scaled = p->bytes_stride_scaled / p->bytes_per_frame;
       p->bytes_to_slide = 0;
-      msg_Dbg( p_filter, "%.3f scale, %.3f stride_in, %i stride_out",
-               p->scale,
-               p->frames_stride_scaled,
-               (int)( p->bytes_stride / p->bytes_per_frame ) );
     }
 
     size_t i_outsize = calculate_output_buffer_size ( p_filter, p_in_buf->i_buffer );
-- 
2.55.0

