From 4cf21a39a9aa3d8d14fc32c4e5d65d9744b4b9c0 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 14 Sep 2026 02:06:35 -0400
Subject: [PATCH 22/25] pipewire: request the graph rate of the stream

The PipeWire output never set node.rate, so the server kept whatever rate
the graph was already running at and resampled the stream into it. For a
44.1 kHz file on a 48 kHz graph that is a permanent resample, which is
both wasteful and audible once rate adaption kicks in.

Set node.rate to the sample rate of the stream, like the PulseAudio
protocol server already does on behalf of its clients, so both back-ends
behave the same. This is only a hint: the server keeps its current rate
when it cannot switch, and then resamples exactly as before.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 modules/audio_output/pipewire.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/modules/audio_output/pipewire.c b/modules/audio_output/pipewire.c
index 7ca52268f9..84eec0ba07 100644
--- a/modules/audio_output/pipewire.c
+++ b/modules/audio_output/pipewire.c
@@ -583,6 +583,15 @@ static struct vlc_pw_stream *vlc_pw_stream_create(audio_output_t *aout,
     if (unlikely(props == NULL))
         return NULL;
 
+    /* Ask the graph to run at the sample rate of the stream, so that the
+     * server does not need to resample. This is only a hint: the server keeps
+     * its current rate if it cannot switch (other streams running, rate not in
+     * the allowed list, forced rate...), and resamples as it did before. The
+     * PulseAudio protocol server sets the same property on behalf of its
+     * clients, so this also makes both back-ends behave alike. */
+    if (likely(fmt->i_rate != 0))
+        pw_properties_setf(props, PW_KEY_NODE_RATE, "1/%u", fmt->i_rate);
+
     char *role = var_InheritString(aout, "role");
     if (role != NULL) { /* Capitalise the first character */
         pw_properties_setf(props, PW_KEY_MEDIA_ROLE, "%c%s",
