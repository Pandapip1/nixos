From 4c08aa2052fcfb657e4e7392a88c270d477fa431 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Sun, 13 Sep 2026 20:04:53 -0400
Subject: [PATCH 14/25] demux: mp4: let a seek recover from an unknown read
 position

b_error is raised when a seek fails and the seek back to where we were
fails as well, leaving the read position unknown. DemuxFrag() checks it
and reports end of stream from then on, and nothing ever lowers it, so
the file is finished as far as the demuxer is concerned.

It does not have to be. A seek establishes a position of its own: if it
succeeds we know exactly where we are, and if it fails but the restore
works we are back where we started. Only a failed restore leaves the
question open, and that path raises the flag again.

Lower it when a seek is attempted, so dragging the seek bar recovers a
stream that would otherwise stay dead until the file is reopened.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 modules/demux/mp4/mp4.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/modules/demux/mp4/mp4.c b/modules/demux/mp4/mp4.c
index 3ef4e96a09..fb7cde6c1a 100644
--- a/modules/demux/mp4/mp4.c
+++ b/modules/demux/mp4/mp4.c
@@ -1930,6 +1930,11 @@ static int Seek( demux_t *p_demux, vlc_tick_t i_date, bool b_accurate )
     demux_sys_t *p_sys = p_demux->p_sys;
     unsigned int i_track;
 
+    /* A seek re-establishes where we are reading from, so whatever left the
+     * position unknown no longer holds. If this attempt fails and the restore
+     * below fails with it, the flag is raised again. */
+    p_sys->b_error = false;
+
     /* Now for each stream try to go to this time */
     vlc_tick_t i_start = i_date;
     for( i_track = 0; i_track < p_sys->i_tracks; i_track++ )
@@ -2130,6 +2135,11 @@ static void FragTrunSeekToTime( mp4_track_t *p_track, stime_t i_target_time )
 static int FragSeekToTime( demux_t *p_demux, vlc_tick_t i_nztime, bool b_accurate )
 {
     demux_sys_t *p_sys = p_demux->p_sys;
+
+    /* A seek re-establishes where we are reading from, so whatever left the
+     * position unknown no longer holds. If this attempt fails and the restore
+     * below fails with it, the flag is raised again. */
+    p_sys->b_error = false;
     uint64_t i64 = UINT64_MAX;
     uint32_t i_segment_type = ATOM_moof;
     stime_t  i_segment_time = INVALID_SEGMENT_TIME;
-- 
