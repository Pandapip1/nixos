From 9c424274e38e637739d0101936f4cd724a651658 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Sun, 13 Sep 2026 19:13:22 -0400
Subject: [PATCH 06/20] demux: ty: clear the end of file flag when seeking

Demux() returns early on p_sys->eof, and once the flag is raised at the
end of the file nothing lowers it again: the two seek helpers only ever
set it, on their own failure paths. So seeking after playback has ended
repositions the stream and reports success, and then the next Demux()
call short circuits and declares end of file again.

The input takes that as the stream having ended, so repeating a file does
not work and dragging the seek bar after the end does nothing, with the
demuxer reporting success the whole time.

Clear it when a seek is asked for. The seek helpers raise it again if
they cannot reposition the stream.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 modules/demux/ty.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/modules/demux/ty.c b/modules/demux/ty.c
index 7752c0722e..7d1a0b0ece 100644
--- a/modules/demux/ty.c
+++ b/modules/demux/ty.c
@@ -529,7 +529,13 @@ static int Control(demux_t *p_demux, int i_query, va_list args)
         f = va_arg( args, double );
         /* msg_Dbg(p_demux, "Control - set position to %2.3f", f); */
         if (p_sys->i_stream_size != 0)
+        {
+            /* The end of file flag short circuits Demux() and nothing else
+             * ever clears it, so a seek out of the end of the file has to.
+             * The seek sets it again if it cannot reposition the stream. */
+            p_sys->eof = false;
             return ty_stream_seek_pct(p_demux, f);
+        }
         return VLC_EGENERIC;
     case DEMUX_GET_TIME:
         /* return TiVo timestamp */
@@ -543,6 +549,8 @@ static int Control(demux_t *p_demux, int i_query, va_list args)
         *va_arg(args, vlc_tick_t *) = 0;
         return VLC_SUCCESS;
     case DEMUX_SET_TIME:      /* arg is time in microsecs */
+        /* See DEMUX_SET_POSITION above. */
+        p_sys->eof = false;
         return ty_stream_seek_time(p_demux,
                                    NS_FROM_VLC_TICK(va_arg( args, vlc_tick_t )));
     case DEMUX_CAN_PAUSE:
