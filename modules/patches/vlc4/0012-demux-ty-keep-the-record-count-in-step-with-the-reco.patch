From 60f13c238587894472cf7c7147e5bb2520de8049 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Sun, 13 Sep 2026 19:51:22 -0400
Subject: [PATCH 12/25] demux: ty: keep the record count in step with the
 record headers

get_chunk_header() commits the record count to p_sys straight after
reading it, then frees the header array and rebuilds it, and can leave
between the two: a count at or above MAX_NUM_RECS, a short read of the
four byte prefix, a failed allocation, or a truncated header block. The
count is left describing an array that is either gone or is the previous,
smaller one.

Demux() checks the return value and the count, so it is safe, but
ty_stream_seek_pct() and ty_stream_seek_time() call get_chunk_header()
for its side effects and then index rec_hdrs unconditionally. On a
truncated or malformed file that is a NULL dereference, or a read past
the end of the previous allocation.

Commit the count only once the array it describes exists, and clear it
where the array is released. The parse failure path already did this.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 modules/demux/ty.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/modules/demux/ty.c b/modules/demux/ty.c
index 7d1a0b0ece..88e8d37c9a 100644
--- a/modules/demux/ty.c
+++ b/modules/demux/ty.c
@@ -1949,7 +1949,7 @@ static int get_chunk_header(demux_t *p_demux)
     if (p_peek[3] & 0x80)
     {
         /* 16 bit rec cnt */
-        p_sys->i_num_recs = i_num_recs = (p_peek[1] << 8) + p_peek[0];
+        i_num_recs = (p_peek[1] << 8) + p_peek[0];
         p_sys->i_seq_rec = (p_peek[3] << 8) + p_peek[2];
         if (p_sys->i_seq_rec != 0xffff)
         {
@@ -1959,7 +1959,7 @@ static int get_chunk_header(demux_t *p_demux)
     else
     {
         /* 8 bit reclen - tivo 1.3 format */
-        p_sys->i_num_recs = i_num_recs = p_peek[0];
+        i_num_recs = p_peek[0];
         p_sys->i_seq_rec = p_peek[1];
     }
 
@@ -1973,6 +1973,10 @@ static int get_chunk_header(demux_t *p_demux)
 
     free(p_sys->rec_hdrs);
     p_sys->rec_hdrs = NULL;
+    /* Keep the count in step with the array. Every bail-out below leaves the
+     * array gone, and the seek helpers index it without checking whether this
+     * function succeeded. */
+    p_sys->i_num_recs = 0;
 
     /* skip past the 4 bytes we "peeked" earlier */
     if(vlc_stream_Read(p_demux->s, NULL, 4) != 4)
@@ -1996,6 +2000,8 @@ static int get_chunk_header(demux_t *p_demux)
         return VLC_ENOMEM;
     }
 
+    p_sys->i_num_recs = i_num_recs;
+
     p_sys->i_stuff_cnt = CHUNK_SIZE - 4 -
         (p_sys->i_num_recs * REC_SIZE) - i_payload_size;
     if (p_sys->i_stuff_cnt > 0)
-- 
