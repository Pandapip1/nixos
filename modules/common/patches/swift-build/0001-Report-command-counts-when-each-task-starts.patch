     }
 }
 
+/// The build's command counts at the moment a task started, for ninja-style
+/// `[started/total]` progress lines.
+public struct BuildOperationTaskProgress: Serializable, Equatable, Sendable {
+    /// The number of commands started so far, including this one.
+    public let startedCount: Int
+
+    /// The most commands the build could still need to execute. Like the
+    /// total in the build's status messages, it can grow as dependency
+    /// scanning discovers more work.
+    public let maxCount: Int
+
+    public init(startedCount: Int, maxCount: Int) {
+        self.startedCount = startedCount
+        self.maxCount = maxCount
+    }
+
+    public init(from deserializer: any Deserializer) throws {
+        try deserializer.beginAggregate(2)
+        self.startedCount = try deserializer.deserialize()
+        self.maxCount = try deserializer.deserialize()
+    }
+
+    public func serialize<T: Serializer>(to serializer: T) {
+        serializer.serializeAggregate(2) {
+            serializer.serialize(self.startedCount)
+            serializer.serialize(self.maxCount)
+        }
+    }
+}
+
 public struct BuildOperationTaskStarted: Message, Equatable {
