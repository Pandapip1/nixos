+  /// How the guest's network device reaches the outside.
+  struct Network: Decodable {
+    /// "nat": Virtualization.framework's NAT. macOS implements it with
+    /// Internet Sharing, which enables IP forwarding and loads its own pf
+    /// ruleset (including `set skip on lo0`) on the host.
+    /// "unixgram": Ethernet frames, one per datagram, over a Unix datagram
+    /// socket to a user-mode network stack such as gvproxy's
+    /// `-listen-vfkit unixgram://<path>`. Leaves the host's network
+    /// configuration alone.
+    var mode: String = "nat"
+    /// The user-mode stack's listening socket, for "unixgram".
+    var path: String?
+
+    init() {}
+
+    enum CodingKeys: String, CodingKey, CaseIterable { case mode, path }
+
+    init(from decoder: Decoder) throws {
+      let container = try decoder.container(keyedBy: CodingKeys.self)
+      try decoder.rejectUnknownKeys(CodingKeys.self)
+      mode = try container.decodeIfPresent(String.self, forKey: .mode) ?? "nat"
+      path = try container.decodeIfPresent(String.self, forKey: .path)
+    }
+  }
+
