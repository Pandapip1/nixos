     var mode: String = "stdio"
diff --git a/vzvm/Sources/vzvm/UnixgramNetwork.swift b/vzvm/Sources/vzvm/UnixgramNetwork.swift
new file mode 100644
index 0000000..da61864
--- /dev/null
+++ b/vzvm/Sources/vzvm/UnixgramNetwork.swift
@@ -0,0 +1,76 @@
+import Darwin
+import Foundation
+
+/// The guest's network link to a user-mode network stack (gvproxy's
+/// `-listen-vfkit`, or anything speaking vfkit's protocol): one Ethernet frame
+/// per datagram over a connected Unix datagram socket.
+enum UnixgramNetwork {
+  /// Connects to the stack listening at `serverPath`. The returned handle is
+  /// meant for `VZFileHandleNetworkDeviceAttachment`, which keeps it open for
+  /// the life of the virtual machine.
+  static func connect(to serverPath: String) throws -> FileHandle {
+    let fd = socket(AF_UNIX, SOCK_DGRAM, 0)
+    guard fd >= 0 else { throw failure("socket") }
+    var connected = false
+    defer { if !connected { close(fd) } }
+
+    // The stack learns where to send frames from this socket's address, so it
+    // must be bound to a path. One vzvm per stack, so the name is fixed and a
+    // leftover from an earlier run is replaced.
+    let clientPath = serverPath + ".vzvm"
+    unlink(clientPath)
+    try withAddress(clientPath) { address, length in
+      guard bind(fd, address, length) == 0 else { throw failure("bind \(clientPath)") }
+    }
+    try withAddress(serverPath) { address, length in
+      guard Darwin.connect(fd, address, length) == 0 else {
+        throw failure("connect \(serverPath)")
+      }
+    }
+
+    // The sizes vfkit and gvproxy use: the receive side has to absorb bursts.
+    try setBufferSize(fd, SO_SNDBUF, 1 << 20)
+    try setBufferSize(fd, SO_RCVBUF, 4 << 20)
+
+    // vfkit's handshake: gvproxy takes the peer address from this first
+    // datagram and discards it.
+    let magic = Array("VFKT".utf8)
+    guard send(fd, magic, magic.count, 0) == magic.count else { throw failure("send handshake") }
+
+    connected = true
+    return FileHandle(fileDescriptor: fd, closeOnDealloc: true)
+  }
+
+  private static func setBufferSize(_ fd: Int32, _ option: Int32, _ size: Int32) throws {
+    var value = size
+    guard setsockopt(fd, SOL_SOCKET, option, &value, socklen_t(MemoryLayout<Int32>.size)) == 0
+    else { throw failure("setsockopt") }
+  }
+
+  private static func withAddress(
+    _ path: String, _ body: (UnsafePointer<sockaddr>, socklen_t) throws -> Void
+  ) throws {
+    var address = sockaddr_un()
+    let bytes = Array(path.utf8)
+    let capacity = MemoryLayout.size(ofValue: address.sun_path)
+    guard bytes.count < capacity else {
+      throw VZVMError.config(
+        "socket path is \(bytes.count) bytes, over the \(capacity - 1)-byte limit: \(path)")
+    }
+    address.sun_family = sa_family_t(AF_UNIX)
+    address.sun_len = UInt8(MemoryLayout<sockaddr_un>.size)
+    withUnsafeMutableBytes(of: &address.sun_path) { raw in
+      raw.copyBytes(from: bytes)
+      raw[bytes.count] = 0
+    }
+    try withUnsafePointer(to: &address) { pointer in
+      try pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+        try body($0, socklen_t(MemoryLayout<sockaddr_un>.size))
+      }
+    }
+  }
+
+  private static func failure(_ what: String) -> VZVMError {
+    .runtime("network: \(what): \(String(cString: strerror(errno)))")
+  }
+}
