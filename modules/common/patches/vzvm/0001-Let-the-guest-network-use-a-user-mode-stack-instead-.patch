+  private static func networkAttachment(
+    _ network: Config.Network
+  ) throws -> VZNetworkDeviceAttachment {
+    switch network.mode {
+    case "nat":
+      return VZNATNetworkDeviceAttachment()
+    case "unixgram":
+      // Preflight checked that the path is set.
+      return VZFileHandleNetworkDeviceAttachment(
+        fileHandle: try UnixgramNetwork.connect(to: network.path ?? ""))
+    default:
+      throw VZVMError.config("network.mode must be \"nat\" or \"unixgram\", not \"\(network.mode)\"")
+    }
+  }
