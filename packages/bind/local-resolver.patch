+/*
+ * When there is no network at all, every server fails at once with "no route"
+ * and the fetch would SERVFAIL within milliseconds. Instead, park the fetch
+ * until the routing table changes (dns_resolver_networkchanged(), driven by
+ * the server's routing socket) and try again then. Retries are limited, and
+ * the fetch's lifetime timer still ends it at the resolver-query-timeout
+ * deadline if the network never comes.
+ */
+#define NETRETRY_MAX 5U
+
+static bool
+fctx_netwait(fetchctx_t *fctx) {
+	dns_resolver_t *res = fctx->res;
+	isc_time_t now;
+	isc_sockaddr_t *sa = NULL, *next_sa = NULL;
+
+	if (fctx->neterr == 0 || fctx->netretries >= NETRETRY_MAX ||
+	    !dns_resolver_networkdown(res) ||
+	    atomic_load_acquire(&res->exiting))
+	{
+		return false;
+	}
+
+	now = isc_time_now();
+	if (isc_time_microdiff(&fctx->expires, &now) == 0) {
+		return false;
+	}
+
+	fctx->netretries++;
+	isc_log_write(dns_lctx, DNS_LOGCATEGORY_RESOLVER,
+		      DNS_LOGMODULE_RESOLVER, ISC_LOG_INFO,
+		      "no network while resolving '%s'; "
+		      "waiting for a network change (retry %u of %u)",
+		      fctx->info, fctx->netretries, NETRETRY_MAX);
+
+	/* Forget the servers that were only bad because there was no route. */
+	for (sa = ISC_LIST_HEAD(fctx->bad); sa != NULL; sa = next_sa) {
+		next_sa = ISC_LIST_NEXT(sa, link);
+		ISC_LIST_UNLINK(fctx->bad, sa, link);
+		isc_mem_put(fctx->mctx, sa, sizeof(*sa));
+	}
+
+	LOCK(&res->netwaitlock);
+	ISC_LIST_APPEND(res->netwaiters, fctx, netwaitlink);
+	fctx->netwaiting = true;
+	UNLOCK(&res->netwaitlock);
+
+	return true;
+}
+
+static void
+fctx_netwait_cancel(fetchctx_t *fctx) {
+	dns_resolver_t *res = fctx->res;
+
+	LOCK(&res->netwaitlock);
+	if (fctx->netwaiting) {
+		ISC_LIST_UNLINK(res->netwaiters, fctx, netwaitlink);
+		fctx->netwaiting = false;
+	}
+	UNLOCK(&res->netwaitlock);
+}
