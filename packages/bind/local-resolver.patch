+				      NULL);
+	if (result != ISC_R_SUCCESS) {
+		goto cleanup;
+	}
+
+	dns_view_getadb(view, &adb);
+	dispatchmgr = dns_view_getdispatchmgr(view);
+	if (adb == NULL || dispatchmgr == NULL) {
+		goto cleanup;
+	}
+
+	for (result = dns_rdataset_first(&nameservers); result == ISC_R_SUCCESS;
+	     result = dns_rdataset_next(&nameservers))
