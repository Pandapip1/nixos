+void
+dns_dispatchmgr_touchtcp(dns_dispatchmgr_t *mgr, const isc_sockaddr_t *peer) {
+	struct cds_lfht_iter iter;
+	dns_dispatch_t *disp = NULL;
+	uint32_t tid = isc_tid();
+
+	REQUIRE(VALID_DISPATCHMGR(mgr));
+	REQUIRE(peer != NULL);
+
+	if (mgr->reuse_timeout == 0 || tid >= mgr->nloops) {
+		return;
+	}
+
+	/*
+	 * Reusable TCP connections are kept per loop, so only this loop's
+	 * connections are ones a query handled here could reuse.
+	 */
+	rcu_read_lock();
+	cds_lfht_for_each_entry(mgr->tcps[tid], &iter, disp, ht_node) {
+		if (disp->state == DNS_DISPATCHSTATE_CONNECTED &&
+		    disp->handle != NULL && ISC_LIST_EMPTY(disp->active) &&
+		    isc_sockaddr_equal(&disp->peer, peer))
+		{
+			isc_nmhandle_settimeout(disp->handle,
+						mgr->reuse_timeout);
+		}
+	}
+	rcu_read_unlock();
+}
