+ * A query was answered from the cache. Find the servers it would have been
+ * sent to (the cached delegation for the name, and those servers' cached
+ * addresses; nothing is looked up) and restart the idle timer on any open TCP
+ * connection to them, so the connection is still there for the next query
+ * that does need them. Mainly useful when each new connection is expensive,
+ * as when recursion goes through Tor.
+ */
+static void
+query_touchupstream(query_ctx_t *qctx) {
+	dns_view_t *view = qctx->client->view;
+	dns_adb_t *adb = NULL;
+	dns_dispatchmgr_t *dispatchmgr = NULL;
+	dns_fixedname_t ffixed;
+	dns_name_t *fname = dns_fixedname_initname(&ffixed);
